<symbol id="icon-chev-right" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 18l6-6-6-6"/></symbol>
<symbol id="icon-palette" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.48-9-10-9z"/><circle cx="6.5" cy="11.5" r="1.5" fill="currentColor"/><circle cx="9.5" cy="7.5" r="1.5" fill="currentColor"/><circle cx="14.5" cy="7.5" r="1.5" fill="currentColor"/><circle cx="17.5" cy="11.5" r="1.5" fill="currentColor"/></symbol>
<symbol id="icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13" y="3" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3" y="13" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13" y="13" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
<symbol id="icon-table" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="M3 9h18M3 15h18M9 3v18"/></symbol>
<symbol id="icon-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="10" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="15" y="3" width="6" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="15" y="11" width="6" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3" y="15" width="10" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
<symbol id="icon-heart" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 20s-7-4.5-9.3-9A5.2 5.2 0 0 1 12 6.4 5.2 5.2 0 0 1 21.3 11C19 15.5 12 20 12 20z"/></symbol>
<symbol id="icon-wallet" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="M3 10h18M16 15h3"/></symbol>
<symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="M2 20c0-3.5 3-5.5 7-5.5s7 2 7 5.5"/><circle cx="17.5" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="M17.5 14.5c2.9 0 4.5 1.8 4.5 4.5"/></symbol>
<symbol id="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></symbol>
<symbol id="icon-moon" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></symbol>
<symbol id="icon-waves" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M2 8c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 13c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></symbol>
<symbol id="icon-tree" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3l5 6h-3l4 5h-4v4h-4v-4H6l4-5H7l5-6z"/></symbol>
<symbol id="icon-sunset" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M17 18a5 5 0 0 0-10 0M12 9V3M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M3 22h18"/></symbol>
<symbol id="icon-hand" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12m0-6.5v-1a1.5 1.5 0 0 1 3 0V12m0-5.5a1.5 1.5 0 0 1 3 0V13a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6v-2a1.5 1.5 0 0 1 3 0"/></symbol>
<symbol id="icon-coffee" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M18 8h1a3 3 0 0 1 0 6h-1M3 8h15v6a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8zM7 2v2M11 2v2"/></symbol>
<symbol id="icon-leaf" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M6 21c0-9 4-15 14-17 0 10-5 15-12 15"/><path fill="none" stroke="currentColor" stroke-width="2" d="M6 21c0-6 3-10 9-12"/></symbol>
<symbol id="icon-logout" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/></symbol>
</svg>
<div class="HolyGrail">
<header class="HolyGrail-header">
<a class="header-logo" onclick="showView('dashboard')">DRELLO</a>
<div class="header-search" id="headerSearch"><svg class="icon"><use href="#icon-search"/></svg><input type="search" id="searchInput" placeholder="Search boards..." oninput="handleSearch(this.value)"/></div>
<div class="header-right">
<div style="position:relative"><button class="header-btn" style="padding:0 10px" onclick="toggleThemeMenu(event)" title="Theme"><svg class="icon"><use href="#icon-palette"/></svg></button><div class="theme-dropdown" id="themeDropdown"><div class="theme-dropdown-item active" data-theme="light" onclick="setTheme('light')"><span class="theme-swatch" style="background:#0e74af"></span> Light</div><div class="theme-dropdown-item" data-theme="dark" onclick="setTheme('dark')"><span class="theme-swatch" style="background:#1a1a2e"></span> Dark</div><div class="theme-dropdown-item" data-theme="ocean" onclick="setTheme('ocean')"><span class="theme-swatch" style="background:#0d3b66"></span> Ocean</div><div class="theme-dropdown-item" data-theme="forest" onclick="setTheme('forest')"><span class="theme-swatch" style="background:#2d5016"></span> Forest</div><div class="theme-dropdown-item" data-theme="sunset" onclick="setTheme('sunset')"><span class="theme-swatch" style="background:#c0392b"></span> Sunset</div></div></div>
<div style="position:relative"><button class="header-btn" onclick="toggleDataMenu(event)"><svg class="icon"><use href="#icon-database"/></svg><span class="btn-label">Data</span></button><div class="data-dropdown" id="dataDropdown"><div class="data-dropdown-header">Export</div><div class="data-dropdown-item" onclick="exportData('json')"><svg class="icon icon-sm"><use href="#icon-download"/></svg> JSON</div><div class="data-dropdown-item" onclick="exportData('csv')"><svg class="icon icon-sm"><use href="#icon-download"/></svg> CSV</div><div class="data-dropdown-item" onclick="exportData('blob')"><svg class="icon icon-sm"><use href="#icon-download"/></svg> Blob</div><div class="data-dropdown-divider"></div><div class="data-dropdown-header">Import</div><div class="data-dropdown-item" onclick="showImportDialog('add')"><svg class="icon icon-sm"><use href="#icon-upload"/></svg> Add</div><div class="data-dropdown-item" onclick="showImportDialog('replace')"><svg class="icon icon-sm"><use href="#icon-reset"/></svg> Replace</div><div class="data-dropdown-item" onclick="showImportDialog('merge')"><svg class="icon icon-sm"><use href="#icon-merge"/></svg> Merge</div><div class="data-dropdown-divider"></div><div class="data-dropdown-item" onclick="pickAuxiliaryTasks()"><svg class="icon icon-sm"><use href="#icon-upload"/></svg> Load Auxiliary Tasks</div></div></div>
<button class="header-btn" style="padding:0 10px" onclick="showCreateBoardPopup(event)"><svg class="icon"><use href="#icon-plus"/></svg></button>
<button class="header-btn" style="padding:0 10px"><svg class="icon"><use href="#icon-bell"/></svg></button>
<div class="header-profile" onclick="toggleAside()"><div class="avatar" id="headerAvatar">DU</div><span id="headerUserName">User</span></div>
</div>
</header>
<div class="HolyGrail-body">
<nav class="HolyGrail-nav">
<div class="nav-item active" data-view="dashboard" data-tooltip="Dashboard" onclick="showView('dashboard')"><svg class="icon"><use href="#icon-dashboard"/></svg></div>
<div class="nav-item" data-view="boards" data-tooltip="Boards" onclick="showView('boards')"><svg class="icon"><use href="#icon-home"/></svg></div>
<div class="nav-item" data-view="projects" data-tooltip="Projects" onclick="showView('projects')"><svg class="icon"><use href="#icon-folder"/></svg></div>
<div class="nav-item" data-view="tasks" data-tooltip="Tasks" onclick="showView('tasks')"><svg class="icon"><use href="#icon-list-check"/></svg></div>
<div class="nav-item" data-view="calendar" data-tooltip="Calendar" onclick="showView('calendar')"><svg class="icon"><use href="#icon-calendar"/></svg></div>
<div class="nav-item" data-view="pomodoro" data-tooltip="Pomodoro" onclick="showView('pomodoro')"><svg class="icon"><use href="#icon-clock"/></svg></div>
<div class="nav-item" data-view="health" data-tooltip="Health" onclick="showView('health')"><svg class="icon"><use href="#icon-heart"/></svg></div>
<div class="nav-item" data-view="finance" data-tooltip="Finance" onclick="showView('finance')"><svg class="icon"><use href="#icon-wallet"/></svg></div>
<div class="nav-item auth-admin-only" data-view="users" data-tooltip="Users" onclick="showView('users')"><svg class="icon"><use href="#icon-users"/></svg></div>
<div class="nav-divider"></div>
<div class="nav-item" data-view="settings" data-tooltip="Settings" onclick="showView('settings')"><svg class="icon"><use href="#icon-settings"/></svg></div>
</nav>
<main class="HolyGrail-content">
<div id="view-dashboard" class="content-section active">
<div class="dash-welcome"><h1><svg class="icon"><use href="#icon-hand"/></svg> Welcome back!</h1><p>Here's an overview of your workspace.</p></div>
<div class="dash-grid" id="dashboard_grid"></div>
</div>
<div id="view-boards" class="content-section">
<div id="search_results_info" class="search-results-info no-display"><span id="search_results_text"></span><button onclick="clearSearch()">Clear</button></div>
<section class="boards-list-container" id="starred_section"><h1><svg class="icon" style="color:gold"><use href="#icon-star-filled"/></svg> Starred Boards</h1><div class="boards-list" id="boards_starred_list"></div></section>
<section class="boards-list-container" id="my_section"><h1><svg class="icon"><use href="#icon-user"/></svg> My Boards</h1><div class="boards-list" id="boards_my_list"><a class="board board-add" onclick="showCreateBoardPopup(event);return false"><svg class="icon icon-xl"><use href="#icon-plus"/></svg><span>Create new board...</span></a></div></section>
</div>
<div id="view-board-detail" class="content-section"><div class="board-ribbon"><h1 id="board_ribbon_title"></h1><span class="ribbon-item board-star-ribbon" id="board_ribbon_star" onclick="toggleStar(event)"><svg class="icon"><use href="#icon-star"/></svg></span><span class="ribbon-item"><svg class="icon icon-sm"><use href="#icon-lock"/></svg> Public</span><span class="ribbon-item" style="margin-left:auto" onclick="toggleAside()"><svg class="icon"><use href="#icon-menu-dots"/></svg> Menu</span></div><div id="board_content"></div></div>
<div id="view-projects" class="content-section"><div class="crud-container"><div class="crud-header"><h2>Projects</h2><div class="flex-gap"><div class="view-toggle"><button class="active" onclick="setProjectsView('table',this)"><svg class="icon icon-sm"><use href="#icon-table"/></svg></button><button onclick="setProjectsView('grid',this)"><svg class="icon icon-sm"><use href="#icon-grid"/></svg></button></div><button class="btn btn-green btn-sm" onclick="showProjectForm()"><svg class="icon"><use href="#icon-plus"/></svg> New</button></div></div><div id="projects_table_view"><table class="crud-table"><thead><tr><th>Title</th><th>Owner</th><th>Due</th><th>Board</th><th>Created</th><th>Actions</th></tr></thead><tbody id="projects_table_body"></tbody></table></div><div id="projects_grid_view" class="boards-list no-display"></div></div></div>
<div id="view-tasks" class="content-section"><div class="crud-container"><div class="crud-header"><h2>Tasks</h2><div class="task-type-tabs"><button class="active" onclick="setTaskTypeFilter('all',this)">All</button><button onclick="setTaskTypeFilter('work',this)">Work</button><button onclick="setTaskTypeFilter('aux',this)">Auxiliary</button></div><div class="flex-gap"><div class="view-toggle"><button class="active" onclick="setTasksView('table',this)"><svg class="icon icon-sm"><use href="#icon-table"/></svg></button><button onclick="setTasksView('grid',this)"><svg class="icon icon-sm"><use href="#icon-grid"/></svg></button></div><button class="btn btn-green btn-sm" onclick="showTaskForm()"><svg class="icon"><use href="#icon-plus"/></svg> New</button></div></div><div id="tasks_table_view"><table class="crud-table"><thead><tr><th>Title</th><th>Owner</th><th>Due</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead><tbody id="tasks_table_body"></tbody></table></div><div id="tasks_grid_view" class="boards-list no-display"></div></div></div>
<div id="view-calendar" class="content-section"><div class="cal-container"><div class="cal-header"><h2 id="cal_title"></h2><div class="cal-nav"><button onclick="calNav(-1)"><svg class="icon icon-sm"><use href="#icon-chev-left"/></svg></button><button onclick="calToday()">Today</button><button onclick="calNav(1)"><svg class="icon icon-sm"><use href="#icon-chev-right"/></svg></button><div class="cal-view-toggle"><button class="active" onclick="setCalView('month',this)">Month</button><button onclick="setCalView('year',this)">Year</button></div></div></div><div class="cal-body"><div class="cal-sidebar"><h3>Events</h3><div id="cal_events_list"></div></div><div class="cal-grid" id="cal_grid"></div></div></div></div>
<div id="view-pomodoro" class="content-section"><div class="pomodoro-container"><div class="pomo-header"><div class="pomo-status" id="pomo_status">Work Session</div><div class="pomo-substatus" id="pomo_substatus">Select a task to begin</div></div><div class="pomo-progress" id="pomo_progress"><span class="pomo-dot"></span><span class="pomo-dot"></span><span class="pomo-dot"></span><span class="pomo-dot"></span></div><div class="pomodoro-timer" id="pomo_timer">25:00</div><div class="pomodoro-controls"><button class="btn btn-green" onclick="pomoStart()" id="pomo_start_btn"><svg class="icon"><use href="#icon-play"/></svg> Start</button><button class="btn btn-gray" onclick="pomoPause()"><svg class="icon"><use href="#icon-pause"/></svg> Pause</button><button class="btn btn-gray" onclick="pomoReset()"><svg class="icon"><use href="#icon-reset"/></svg> Reset</button></div><div class="pomo-task-select"><label>Work Task</label><select id="pomo_task_select" onchange="pomoTaskSelected()"><option value="">-- Select task --</option></select><label style="margin-top:10px">Auxiliary Task (optional)</label><select id="pomo_break_task_select"><option value="">-- No auxiliary task --</option></select></div><div class="pomo-settings"><div><label>Work (min)</label><input type="number" id="pomo_work" value="25" min="1"></div><div><label>Short Break (min)</label><input type="number" id="pomo_short_break" value="5" min="1"></div><div><label>Long Break (min)</label><input type="number" id="pomo_long_break" value="15" min="5"></div><div><label>Sessions before long break</label><input type="number" id="pomo_sessions" value="4" min="2"></div></div><div class="pomo-log"><h4>Time Log (today)</h4><div id="pomo_log_list"><em style="font-size:12px;color:var(--text-muted)">No sessions yet</em></div></div></div></div>
<div id="view-settings" class="content-section"><div class="settings-container">
<div class="settings-group"><h3>Theme</h3><div class="theme-options"><button class="theme-btn active" data-theme="light" onclick="setTheme('light')"><svg class="icon"><use href="#icon-sun"/></svg> Light</button><button class="theme-btn" data-theme="dark" onclick="setTheme('dark')"><svg class="icon"><use href="#icon-moon"/></svg> Dark</button><button class="theme-btn" data-theme="ocean" onclick="setTheme('ocean')"><svg class="icon"><use href="#icon-waves"/></svg> Ocean</button><button class="theme-btn" data-theme="forest" onclick="setTheme('forest')"><svg class="icon"><use href="#icon-tree"/></svg> Forest</button><button class="theme-btn" data-theme="sunset" onclick="setTheme('sunset')"><svg class="icon"><use href="#icon-sunset"/></svg> Sunset</button></div></div>
<div class="settings-group"><h3>Save Behavior on Close</h3><div class="settings-row"><label>Action</label><select class="form-control" style="width:auto" id="save_on_close_select" onchange="localStorage.setItem('drello_save_behavior',this.value)"><option value="ask">Ask me before closing</option><option value="auto">Auto-export JSON on close</option><option value="none">Do nothing</option></select></div></div>
<div class="settings-group"><h3>Data</h3><div class="settings-row"><label>Export JSON</label><button class="btn btn-gray btn-sm" onclick="exportData('json')">Export</button></div><div class="settings-row"><label>Export CSV</label><button class="btn btn-gray btn-sm" onclick="exportData('csv')">Export</button></div><div class="settings-row"><label>Import</label><button class="btn btn-gray btn-sm" onclick="showImportDialog('add')">Import</button></div><div class="settings-row"><label>Auxiliary Tasks</label><button class="btn btn-gray btn-sm" onclick="pickAuxiliaryTasks()">Load from disk</button></div><div class="settings-row"><label>Reset all</label><button class="btn btn-danger btn-sm" onclick="if(confirm('Reset ALL?')){localStorage.clear();location.reload()}">Reset</button></div></div>
</div></div>
<div id="view-health" class="content-section">
<div class="crud-container">
<div class="module-header">
<h2><svg class="icon"><use href="#icon-heart"/></svg> Health Tracking</h2>
<button class="btn btn-green btn-sm" onclick="showHealthForm()">New</button>
</div>
<div id="health_summary" class="stat-grid"></div>
<div class="table-wrap">
<table class="crud-table">
<thead>
<tr>
<th>Date</th><th>Owner</th><th>Weight</th><th>BP</th><th>HR</th><th>Sleep</th><th>Steps</th><th>Water</th><th>Mood</th><th>Actions</th>
</tr>
</thead>
<tbody id="health_table_body"></tbody>
</table>
</div>
</div>
</div>
<div id="view-finance" class="content-section">
<div class="crud-container">
<div class="module-header">
<h2><svg class="icon"><use href="#icon-wallet"/></svg> Personal Finances</h2>
<div class="flex-gap">
<button class="btn btn-gray btn-sm" onclick="showFinanceAccountForm()">Account</button>
<button class="btn btn-gray btn-sm" onclick="showFinanceTransactionForm()">Transaction</button>
<button class="btn btn-gray btn-sm" onclick="showFinanceBudgetForm()">Budget</button>
</div>
</div>
<div class="finance-tabs">
<button class="active" onclick="setFinanceTab('dashboard',this)">Dashboard</button>
<button onclick="setFinanceTab('accounts',this)">Accounts</button>
<button onclick="setFinanceTab('transactions',this)">Transactions</button>
<button onclick="setFinanceTab('budgets',this)">Budgets</button>
</div>
<div id="finance_panel_dashboard">
<div id="finance_summary" class="stat-grid"></div>
<h3>Recent Transactions</h3>
<div class="table-wrap">
<table class="crud-table">
<thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Category</th><th>Payee</th><th>Amount</th></tr></thead>
<tbody id="finance_recent_body"></tbody>
</table>
</div>
</div>
<div id="finance_panel_accounts" class="auth-hidden">
<div class="table-wrap">
<table class="crud-table">
<thead><tr><th>Name</th><th>Type</th><th>Opening</th><th>Balance</th><th>Active</th><th>Actions</th></tr></thead>
<tbody id="finance_accounts_body"></tbody>
</table>
</div>
</div>
<div id="finance_panel_transactions" class="auth-hidden">
<div class="table-wrap">
<table class="crud-table">
<thead><tr><th>Date</th><th>Type</th><th>Account</th><th>To Account</th><th>Category</th><th>Payee</th><th>Description</th><th>Amount</th><th>Actions</th></tr></thead>
<tbody id="finance_transactions_body"></tbody>
</table>
</div>
</div>
<div id="finance_panel_budgets" class="auth-hidden">
<div class="table-wrap">
<table class="crud-table">
<thead><tr><th>Month</th><th>Category</th><th>Budget</th><th>Spent</th><th>Remaining</th><th>Actions</th></tr></thead>
<tbody id="finance_budgets_body"></tbody>
</table>
</div>
</div>
</div>
</div>
<div id="view-users" class="content-section">
<div class="crud-container">
<div class="module-header">
<h2><svg class="icon"><use href="#icon-users"/></svg> Users</h2>
<div class="flex-gap">
<button class="btn btn-green btn-sm" onclick="showUserForm()">New</button>
<button class="btn btn-gray btn-sm" onclick="authLogout()"><svg class="icon icon-sm"><use href="#icon-logout"/></svg> Logout</button>
</div>
</div>
<div class="table-wrap">
<table class="crud-table">
<thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th>Active</th><th>Created</th><th>Actions</th></tr></thead>
<tbody id="users_table_body"></tbody>
</table>
</div>
</div>
</div>
</main>
<aside class="HolyGrail-aside collapsed" id="mainAside"><div style="padding:15px;background:var(--bg-hover);display:flex;justify-content:space-between;align-items:center"><h2 style="margin:0;font-size:15px">Menu</h2><button onclick="toggleAside()" style="background:none;cursor:pointer;color:var(--text-primary)"><svg class="icon"><use href="#icon-cancel"/></svg></button></div><div style="padding:15px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--border-light)"><div id="asideAvatar" style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#5E98BA,#3d7a9c);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold">DU</div><div><div id="asideUserName" style="font-weight:600">Drello User</div><div id="asideUserEmail" style="font-size:12px;color:var(--text-muted)">user@drello.app</div></div></div><div style="padding:10px 0"><div class="nav-item" style="color:var(--text-primary);width:auto;height:auto;padding:9px 16px;margin:1px 6px;justify-content:flex-start;gap:10px" onclick="handleLogout()"><svg class="icon"><use href="#icon-cancel"/></svg> Logout / Save & Exit</div></div></aside>
</div>
<footer class="HolyGrail-footer">&copy; <span id="footerYear"></span> Drello — Kanban Board App. <a href="#">Privacy</a> · <a href="#">Terms</a></footer>
</div>
<div id="overlay">
<div class="popup" id="popup_create_board"><div class="popup-header"><span>Create Board</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="createBoardSubmit(event)"><div class="form-group"><label>Title *</label><input class="form-control" name="bname" required></div><div class="form-group"><label>Category</label><select class="form-control" name="bcat"><option value="personal">Personal</option><option value="work">Work</option><option value="education">Education</option><option value="health">Health</option><option value="finance">Finance</option><option value="other">Other</option></select></div><div class="form-group"><label>Due Date</label><input class="form-control" type="date" name="bdue"></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Create</button></div></form></div></div>
<div class="popup" id="popup_project_form"><div class="popup-header"><span id="project_form_title">New Project</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveProject(event)"><input type="hidden" name="pid"><div class="form-group"><label>Title *</label><input class="form-control" name="ptitle" required></div><div class="form-group"><label>Description</label><textarea class="form-control" name="pdesc"></textarea></div><div class="form-group"><label>Owner</label><input class="form-control" name="powner" value="Drello User"></div><div class="form-group"><label>Due Date</label><input class="form-control" type="date" name="pdue"></div><div class="form-group"><label>Link to Board</label><select class="form-control" name="pboard" id="project_board_select"><option value="">None</option></select></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_task_form"><div class="popup-header"><span id="task_form_title">New Task</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveTask(event)"><input type="hidden" name="tid"><div class="form-group"><label>Title *</label><input class="form-control" name="ttitle" required></div><div class="form-group"><label>Description</label><textarea class="form-control" name="tdesc"></textarea></div><div class="form-group"><label>Owner</label><input class="form-control" name="towner" value="Drello User"></div><div class="form-group"><label>Due Date</label><input class="form-control" type="date" name="tdue"></div><div class="form-group"><label>Status</label><select class="form-control" name="tstatus"><option value="todo">To Do</option><option value="doing">In Progress</option><option value="done">Done</option></select></div><div class="form-group"><label>Type</label><select class="form-control" name="ttype"><option value="work">Work Task</option><option value="aux">Auxiliary Task</option></select></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_event_form"><div class="popup-header"><span>Add Event</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveEvent(event)"><input type="hidden" name="eid"><div class="form-group"><label>Title *</label><input class="form-control" name="etitle" required></div><div class="form-group"><label>Description</label><textarea class="form-control" name="edesc"></textarea></div><div class="form-group"><label>Owner</label><input class="form-control" name="eowner" value="Drello User"></div><div class="form-group"><label>Date *</label><input class="form-control" type="date" name="edate" required id="event_date_input"></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup popup-large" id="popup_card_display"><div class="popup-header"><span>Card Details</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><div class="card-info-section"><div id="card_popup_title" style="font-size:18px;font-weight:600;margin-bottom:5px"></div><div id="card_popup_list" style="color:var(--text-muted);font-size:12px;margin-bottom:15px"></div><div class="section-label"><svg class="icon icon-sm"><use href="#icon-comment"/></svg> Description</div><div id="card_popup_desc" style="background:var(--bg-hover);padding:10px;border-radius:4px;min-height:40px;font-size:13px;white-space:pre-wrap"></div><div class="section-label"><svg class="icon icon-sm"><use href="#icon-attach"/></svg> Attachments</div><div id="card_popup_attachments"></div><label class="btn btn-gray btn-sm" style="margin-top:8px;cursor:pointer"><svg class="icon"><use href="#icon-plus"/></svg> Add<input type="file" style="display:none" accept="image/*" multiple onchange="uploadAttachment(event)"/></label><div class="section-label"><svg class="icon icon-sm"><use href="#icon-boards"/></svg> Subcards</div><div id="card_popup_subcards"></div><button class="btn btn-gray btn-sm" style="margin-top:8px" onclick="showAddSubcardForm()"><svg class="icon"><use href="#icon-plus"/></svg> Add Subcard</button><div id="subcard_form_area" class="no-display" style="margin-top:8px"><input class="form-control" id="subcard_input" placeholder="Subcard title..."><div class="flex-gap" style="margin-top:5px"><button class="btn btn-green btn-sm" onclick="addSubcard()">Add</button><button class="btn btn-gray btn-sm" onclick="document.getElementById('subcard_form_area').classList.add('no-display')">Cancel</button></div></div><div class="section-label"><svg class="icon icon-sm"><use href="#icon-clock"/></svg> History</div><div id="card_popup_history" style="font-size:11px;color:var(--text-muted)"></div></div><div class="card-actions-section"><h3>Actions</h3><button class="card-action-btn danger" onclick="archiveCardFromPopup()"><svg class="icon icon-sm"><use href="#icon-archive"/></svg> Archive</button></div></div></div>
<div class="popup" id="popup_import"><div class="popup-header"><span>Import Data</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><p id="import_mode_desc" style="color:var(--text-muted);font-size:13px;margin:0 0 12px"></p><div class="form-group"><label>File</label><input type="file" id="import_file" class="form-control" accept=".json,.csv,.blob"></div><div class="flex-gap" style="justify-content:flex-end"><button class="btn btn-gray" onclick="closePopups()">Cancel</button><button class="btn btn-green" onclick="performImport()">Import</button></div></div></div>
<div class="popup" id="popup_health_form"><div class="popup-header"><span>Health Record</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveHealthForm(event)"><input type="hidden" id="health_id"><div class="form-grid"><div class="form-group"><label>Date</label><input type="date" class="form-control" id="health_date" required></div><div class="form-group"><label>Owner</label><select class="form-control" id="health_owner"></select></div><div class="form-group"><label>Weight kg</label><input type="number" step="0.1" class="form-control" id="health_weightKg"></div><div class="form-group"><label>Height cm</label><input type="number" step="0.1" class="form-control" id="health_heightCm"></div><div class="form-group"><label>Body fat %</label><input type="number" step="0.1" class="form-control" id="health_bodyFatPct"></div><div class="form-group"><label>Waist cm</label><input type="number" step="0.1" class="form-control" id="health_waistCm"></div><div class="form-group"><label>Hip cm</label><input type="number" step="0.1" class="form-control" id="health_hipCm"></div><div class="form-group"><label>Systolic BP</label><input type="number" class="form-control" id="health_bpSys"></div><div class="form-group"><label>Diastolic BP</label><input type="number" class="form-control" id="health_bpDia"></div><div class="form-group"><label>Resting HR</label><input type="number" class="form-control" id="health_restingHr"></div><div class="form-group"><label>Sleep hours</label><input type="number" step="0.1" class="form-control" id="health_sleepHours"></div><div class="form-group"><label>Sleep quality</label><select class="form-control" id="health_sleepQuality"><option value="">--</option><option value="1">1 - Very poor</option><option value="2">2 - Poor</option><option value="3">3 - Normal</option><option value="4">4 - Good</option><option value="5">5 - Excellent</option></select></div><div class="form-group"><label>Stress level</label><select class="form-control" id="health_stress"><option value="">--</option><option value="1">1 - Very low</option><option value="2">2 - Low</option><option value="3">3 - Normal</option><option value="4">4 - High</option><option value="5">5 - Very high</option></select></div><div class="form-group"><label>Mood</label><select class="form-control" id="health_mood"><option value="">--</option><option value="very_bad">Very bad</option><option value="bad">Bad</option><option value="neutral">Neutral</option><option value="good">Good</option><option value="very_good">Very good</option></select></div><div class="form-group"><label>Water ml</label><input type="number" class="form-control" id="health_waterMl"></div><div class="form-group"><label>Calories kcal</label><input type="number" class="form-control" id="health_caloriesKcal"></div><div class="form-group"><label>Protein g</label><input type="number" step="0.1" class="form-control" id="health_proteinG"></div><div class="form-group"><label>Carbs g</label><input type="number" step="0.1" class="form-control" id="health_carbsG"></div><div class="form-group"><label>Fat g</label><input type="number" step="0.1" class="form-control" id="health_fatG"></div><div class="form-group"><label>Steps</label><input type="number" class="form-control" id="health_steps"></div><div class="form-group"><label>Exercise min</label><input type="number" class="form-control" id="health_exerciseMinutes"></div><div class="form-group"><label>Medications / supplements</label><input class="form-control" id="health_medications"></div></div><div class="form-group" style="margin-top:10px"><label>Notes</label><textarea class="form-control" id="health_notes"></textarea></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_finance_account_form"><div class="popup-header"><span>Account</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveFinanceAccountForm(event)"><input type="hidden" id="account_id"><div class="form-grid"><div class="form-group"><label>Name</label><input class="form-control" id="account_name" required></div><div class="form-group"><label>Type</label><select class="form-control" id="account_type"><option value="cash">Cash</option><option value="bank">Bank</option><option value="savings">Savings</option><option value="credit">Credit</option><option value="investment">Investment</option><option value="other">Other</option></select></div><div class="form-group"><label>Currency</label><input class="form-control" id="account_currency" value="USD"></div><div class="form-group"><label>Opening balance</label><input type="number" step="0.01" class="form-control" id="account_openingBalance" value="0"></div><div class="form-group"><label>Active</label><select class="form-control" id="account_active"><option value="true">Yes</option><option value="false">No</option></select></div></div><div class="form-group" style="margin-top:10px"><label>Notes</label><textarea class="form-control" id="account_notes"></textarea></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_finance_transaction_form"><div class="popup-header"><span>Transaction</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveFinanceTransactionForm(event)"><input type="hidden" id="tx_id"><div class="form-grid"><div class="form-group"><label>Date</label><input type="date" class="form-control" id="tx_date" required></div><div class="form-group"><label>Type</label><select class="form-control" id="tx_type" onchange="updateTransactionFormVisibility()"><option value="income">Income</option><option value="expense">Expense</option><option value="transfer">Transfer</option></select></div><div class="form-group"><label>Account</label><select class="form-control" id="tx_account"></select></div><div class="form-group" id="tx_toAccountWrap"><label>To account</label><select class="form-control" id="tx_toAccount"></select></div><div class="form-group" id="tx_categoryWrap"><label>Category</label><select class="form-control" id="tx_category"></select></div><div class="form-group"><label>Payee</label><input class="form-control" id="tx_payee"></div><div class="form-group"><label>Amount</label><input type="number" step="0.01" class="form-control" id="tx_amount" required></div><div class="form-group"><label>Owner</label><select class="form-control" id="tx_owner"></select></div></div><div class="form-group" style="margin-top:10px"><label>Description</label><textarea class="form-control" id="tx_description"></textarea></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_finance_budget_form"><div class="popup-header"><span>Budget</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveFinanceBudgetForm(event)"><input type="hidden" id="budget_id"><div class="form-grid"><div class="form-group"><label>Month</label><input type="month" class="form-control" id="budget_month" required></div><div class="form-group"><label>Category</label><select class="form-control" id="budget_category"></select></div><div class="form-group"><label>Limit</label><input type="number" step="0.01" class="form-control" id="budget_limit" required></div></div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
<div class="popup" id="popup_user_form"><div class="popup-header"><span id="userDialogTitle">User</span><span class="icon-cancel" onclick="closePopups()"><svg class="icon"><use href="#icon-cancel"/></svg></span></div><div class="popup-body"><form onsubmit="saveUserForm(event)"><input type="hidden" id="user_id"><div class="form-grid"><div class="form-group"><label>Full name</label><input class="form-control" id="user_name" required></div><div class="form-group"><label>Username</label><input class="form-control" id="user_username" required></div><div class="form-group"><label>Email</label><input class="form-control" id="user_email"></div><div class="form-group"><label>Role</label><select class="form-control" id="user_role"><option value="member">Member</option><option value="admin">Admin</option></select></div><div class="form-group"><label>Active</label><select class="form-control" id="user_active"><option value="true">Yes</option><option value="false">No</option></select></div><div class="form-group"><label>Password</label><input type="password" class="form-control" id="user_password"></div></div><div style="font-size:12px;color:var(--text-muted);margin-top:8px">Password is required for new users. Leave blank when editing to keep the current password.</div><div class="flex-gap" style="justify-content:flex-end;margin-top:15px"><button type="button" class="btn btn-gray" onclick="closePopups()">Cancel</button><button type="submit" class="btn btn-green">Save</button></div></form></div></div>
</div>
<input type="file" id="aux_file_input" accept=".json,application/json" style="display:none" onchange="importAuxiliaryTasksFile(event)">
<script>
const uid=()=>Date.now().toString(36)+'-'+Math.random().toString(36).substr(2,9);
const fmtDate=ts=>ts?new Date(ts).toLocaleDateString():'';
const fmtDateTime=ts=>ts?new Date(ts).toLocaleString():'';
const fmtMin=s=>{const m=Math.floor(s/60);return m>0?`${m}m ${s%60}s`:`${s}s`};
const store={get(k,d){try{return JSON.parse(localStorage.getItem(k))||d}catch(e){return d}},set(k,v){localStorage.setItem(k,JSON.stringify(v))}};
let AppData=store.get('drello_app',{boards:[],projects:[],tasks:[],events:[],pomodoroLog:[]});
function normalizeData(){
if(!AppData.boards)AppData.boards=[];if(!AppData.projects)AppData.projects=[];if(!AppData.tasks)AppData.tasks=[];if(!AppData.events)AppData.events=[];if(!AppData.pomodoroLog)AppData.pomodoroLog=[];
AppData.boards.forEach(b=>{if(!b.id)b.id=uid();if(!b.creationDate)b.creationDate=Date.now();if(!b.lists)b.lists=[];if(b.star===undefined)b.star=false;if(b.closed===undefined)b.closed=false;b.lists.forEach(l=>{if(!l.id)l.id=uid();if(!l.cards)l.cards=[];if(l.closed===undefined)l.closed=false;l.cards.forEach(c=>{if(!c.id)c.id=uid();if(!c.creationDate)c.creationDate=Date.now();if(!c.subcards)c.subcards=[];if(!c.attachments)c.attachments=[];if(!c.history)c.history=[];if(c.movedAt===undefined)c.movedAt=null;if(c.closed===undefined)c.closed=false;if(c.desc===undefined)c.desc='';if(c.cover===undefined)c.cover=-1})})});
AppData.tasks.forEach(t=>{if(!t.id)t.id=uid();if(t.type==='break')t.type='aux';if(!t.type)t.type='work';if(t.trackedSeconds===undefined)t.trackedSeconds=0});
saveApp();
}
function saveApp(){store.set('drello_app',AppData)}
let saveBehavior=localStorage.getItem('drello_save_behavior')||'ask';
document.getElementById('save_on_close_select').value=saveBehavior;
window.addEventListener('beforeunload',function(e){
const behavior=localStorage.getItem('drello_save_behavior')||'ask';
if(behavior==='ask'){e.preventDefault();e.returnValue='';return ''}
if(behavior==='auto'){exportDataSilent()}
});
function exportDataSilent(){
const ts=new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);
const blob=new Blob([JSON.stringify(AppData,null,2)],{type:'application/json'});
const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`drello-export-${ts}.json`;a.click();
}
function handleLogout(){
const behavior=localStorage.getItem('drello_save_behavior')||'ask';
if(behavior==='ask'){
if(confirm('Save data before logging out?')){exportDataSilent()}
}else if(behavior==='auto'){exportDataSilent()}
saveApp();
showView('dashboard');
toggleAside();
}
function setTheme(name){document.body.setAttribute('data-theme',name);localStorage.setItem('drello_theme',name);document.querySelectorAll('.theme-btn').forEach(b=>b.classList.toggle('active',b.dataset.theme===name));document.querySelectorAll('.theme-dropdown-item').forEach(b=>b.classList.toggle('active',b.dataset.theme===name))}
function toggleThemeMenu(e){e.stopPropagation();document.getElementById('themeDropdown').classList.toggle('visible');document.getElementById('dataDropdown').classList.remove('visible')}
(function(){setTheme(localStorage.getItem('drello_theme')||'light')})();
function showView(name){document.querySelectorAll('.content-section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.nav-item[data-view]').forEach(n=>n.classList.remove('active'));const v=document.getElementById('view-'+name);if(v)v.classList.add('active');const n=document.querySelector(`.nav-item[data-view="${name}"]`);if(n)n.classList.add('active');
if(name==='dashboard')renderDashboard();if(name==='boards'){renderBoards();clearSearch()}if(name==='projects')renderProjects();if(name==='tasks')renderTasks();if(name==='calendar')renderCalendar();if(name==='pomodoro')pomoPopulateSelects();
document.getElementById('mainAside').classList.add('collapsed')}
function toggleAside(){const a=document.getElementById('mainAside');if(window.innerWidth<=700)a.classList.toggle('show-mobile');else a.classList.toggle('collapsed')}
function renderDashboard(){
const g=document.getElementById('dashboard_grid');
const totalBoards=AppData.boards.filter(b=>!b.closed).length;
const totalLists=AppData.boards.reduce((a,b)=>a+(b.lists||[]).filter(l=>!l.closed).length,0);
const totalCards=AppData.boards.reduce((a,b)=>a+(b.lists||[]).reduce((c,l)=>c+(l.cards||[]).filter(cd=>!cd.closed).length,0),0);
const totalProjects=AppData.projects.length;
const totalTasks=AppData.tasks.length;
const tasksTodo=AppData.tasks.filter(t=>t.status==='todo').length;
const tasksDoing=AppData.tasks.filter(t=>t.status==='doing').length;
const tasksDone=AppData.tasks.filter(t=>t.status==='done').length;
const auxTasks=AppData.tasks.filter(t=>t.type==='aux').length;
const todayEvents=AppData.events.filter(e=>e.date===new Date().toISOString().slice(0,10)).length;
const totalEvents=AppData.events.length;
const today=new Date().toDateString();
const todaySessions=AppData.pomodoroLog.filter(l=>new Date(l.ts).toDateString()===today);
const todayTime=todaySessions.reduce((a,l)=>a+l.seconds,0);
const totalTracked=AppData.tasks.reduce((a,t)=>a+(t.trackedSeconds||0),0);
g.innerHTML=`
<div class="dash-card"><h3><svg class="icon"><use href="#icon-boards"/></svg> Boards</h3><div class="dash-stat">${totalBoards}</div><div class="dash-stat-label">active boards</div><div class="dash-row"><span class="label">Lists</span><span class="value">${totalLists}</span></div><div class="dash-row"><span class="label">Cards</span><span class="value">${totalCards}</span></div><div class="dash-row"><span class="label">Starred</span><span class="value">${AppData.boards.filter(b=>b.star&&!b.closed).length}</span></div></div>
<div class="dash-card"><h3><svg class="icon"><use href="#icon-folder"/></svg> Projects</h3><div class="dash-stat">${totalProjects}</div><div class="dash-stat-label">total projects</div><div class="dash-row"><span class="label">Linked to boards</span><span class="value">${AppData.projects.filter(p=>p.boardId).length}</span></div></div>
<div class="dash-card"><h3><svg class="icon"><use href="#icon-list-check"/></svg> Tasks</h3><div class="dash-stat">${totalTasks}</div><div class="dash-stat-label">total tasks</div><div class="dash-row"><span class="label">To Do</span><span class="value">${tasksTodo}</span></div><div class="dash-row"><span class="label">In Progress</span><span class="value">${tasksDoing}</span></div><div class="dash-row"><span class="label">Done</span><span class="value">${tasksDone}</span></div><div class="dash-row"><span class="label">Auxiliary tasks</span><span class="value">${auxTasks}</span></div></div>
<div class="dash-card"><h3><svg class="icon"><use href="#icon-calendar"/></svg> Calendar</h3><div class="dash-stat">${todayEvents}</div><div class="dash-stat-label">events today</div><div class="dash-row"><span class="label">Total events</span><span class="value">${totalEvents}</span></div></div>
<div class="dash-card"><h3><svg class="icon"><use href="#icon-clock"/></svg> Pomodoro</h3><div class="dash-stat">${todaySessions.length}</div><div class="dash-stat-label">sessions today</div><div class="dash-row"><span class="label">Focus today</span><span class="value">${fmtMin(todayTime)}</span></div><div class="dash-row"><span class="label">Total tracked</span><span class="value">${fmtMin(totalTracked)}</span></div></div>
`;
}
function handleSearch(q){const info=document.getElementById('search_results_info');if(!q.trim()){clearSearch();return}info.classList.remove('no-display');document.getElementById('starred_section').classList.add('no-display');const my=document.getElementById('my_section');my.classList.remove('no-display');const results=AppData.boards.filter(b=>!b.closed&&b.name.toLowerCase().includes(q.toLowerCase()));document.getElementById('search_results_text').textContent=`${results.length} board(s) for "${q}"`;const list=document.getElementById('boards_my_list');list.innerHTML='';results.forEach(b=>list.appendChild(createBoardNode(b)));if(!results.length)list.innerHTML='<p style="color:rgba(255,255,255,.7)">No results.</p>';my.querySelector('h1').innerHTML='<svg class="icon"><use href="#icon-search"/></svg> Results'}
function clearSearch(){document.getElementById('search_results_info').classList.add('no-display');document.getElementById('searchInput').value='';document.getElementById('starred_section').classList.remove('no-display');const my=document.getElementById('my_section');my.querySelector('h1').innerHTML='<svg class="icon"><use href="#icon-user"/></svg> My Boards';renderBoards()}
document.getElementById('searchInput').addEventListener('focus',function(){document.getElementById('headerSearch').classList.add('focused')});
document.getElementById('searchInput').addEventListener('blur',function(){document.getElementById('headerSearch').classList.remove('focused')});
function renderBoards(){const my=document.getElementById('boards_my_list'),st=document.getElementById('boards_starred_list');const add=my.querySelector('.board-add');my.innerHTML='';st.innerHTML='';AppData.boards.filter(b=>!b.closed).forEach(b=>{const n=createBoardNode(b);my.appendChild(n);if(b.star)st.appendChild(n.cloneNode(true))});my.appendChild(add)}
function createBoardNode(b){const el=document.createElement('a');el.className='board';el.href='#';el.onclick=e=>{if(!e.target.closest('.board-star')){e.preventDefault();openBoard(b.id)}};el.innerHTML=`<span class="board-star${b.star?' starred':''}" onclick="toggleStarBoard('${b.id}',event)"><svg class="icon"><use href="#icon-star"/></svg></span><div><div class="board-title">${b.name}</div><div class="board-meta"><span class="board-category-badge">${b.category||'other'}</span></div></div><div class="board-meta">${b.dueDate?'<span>'+fmtDate(b.dueDate)+'</span>':''}<span>${(b.lists||[]).length} lists</span></div>`;return el}
function createBoardSubmit(e){e.preventDefault();const f=e.target;AppData.boards.push({id:uid(),name:f.bname.value,category:f.bcat.value,dueDate:f.bdue.value||null,creationDate:Date.now(),star:false,closed:false,lists:[]});saveApp();closePopups();renderBoards();f.reset()}
function showCreateBoardPopup(e){e&&e.stopPropagation();showPopup('popup_create_board')}
function toggleStarBoard(id,e){e.stopPropagation();const b=AppData.boards.find(x=>x.id===id);if(b){b.star=!b.star;saveApp();renderBoards()}}
function openBoard(id){const b=AppData.boards.find(x=>x.id===id);if(!b)return;localStorage.setItem('currentBoard',id);document.getElementById('board_ribbon_title').textContent=b.name;const star=document.getElementById('board_ribbon_star');star.classList.toggle('starred',b.star);star.dataset.id=id;document.getElementById('view-boards').classList.remove('active');document.getElementById('view-board-detail').classList.add('active');renderBoardLists(b)}
function renderBoardLists(board){const c=document.getElementById('board_content');c.innerHTML='';(board.lists||[]).filter(l=>!l.closed).forEach(l=>c.appendChild(createListEl(l,board)));const add=document.createElement('div');add.className='add-list-btn';add.innerHTML='<svg class="icon"><use href="#icon-plus"/></svg> Add a list...';add.onclick=()=>showAddListForm(board);c.appendChild(add);setupDragDrop()}
function createListEl(list,board){const el=document.createElement('div');el.className='list';el.dataset.id=list.id;el.innerHTML=`<div class="list-head"><span>${list.name}</span><span class="icon-menu-btn" onclick="archiveList('${board.id}','${list.id}')"><svg class="icon icon-sm"><use href="#icon-cancel"/></svg></span></div>`;const body=document.createElement('div');body.className='list-body';body.dataset.listId=list.id;(list.cards||[]).filter(c=>!c.closed).forEach(card=>body.appendChild(createCardEl(card,board,list)));el.appendChild(body);const ab=document.createElement('div');ab.className='add-card-btn';ab.textContent='+ Add a card...';ab.onclick=e=>showAddCardForm(e,board,list);el.appendChild(ab);return el}
function createCardEl(card,board,list){const el=document.createElement('div');el.className='card';el.draggable=true;el.dataset.id=card.id;el.dataset.list=list.id;let coverHTML='';if(card.attachments&&card.attachments.length&&card.cover>=0&&card.attachments[card.cover])coverHTML=`<div class="card-cover-img"><img src="${card.attachments[card.cover].data}"/></div>`;let subHTML='';if(card.subcards&&card.subcards.length)subHTML='<div class="card-subcards">'+card.subcards.filter(s=>!s.closed).map(s=>`<div class="subcard-item">${s.name}</div>`).join('')+'</div>';const badges=[];if(card.desc)badges.push('<span><svg class="icon icon-sm"><use href="#icon-comment"/></svg></span>');if(card.attachments&&card.attachments.length)badges.push(`<span><svg class="icon icon-sm"><use href="#icon-attach"/></svg>${card.attachments.length}</span>`);if(card.subcards&&card.subcards.length)badges.push(`<span><svg class="icon icon-sm"><use href="#icon-boards"/></svg>${card.subcards.length}</span>`);el.innerHTML=`<span class="card-edit-btn" onclick="openCardPopup('${card.id}','${list.id}',event)"><svg class="icon icon-sm"><use href="#icon-pencil"/></svg></span>${coverHTML}<div class="card-title">${card.name}</div><div class="card-badges">${badges.join('')}</div><div class="card-meta">${fmtDate(card.creationDate)}${card.movedAt?' · '+fmtDateTime(card.movedAt):''}</div>${subHTML}`;el.onclick=e=>{if(!e.target.closest('.card-edit-btn'))openCardPopup(card.id,list.id,e)};el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',JSON.stringify({cardId:card.id,fromList:list.id}));e.dataTransfer.effectAllowed='move';setTimeout(()=>el.classList.add('dragging-card'),0)});el.addEventListener('dragend',()=>el.classList.remove('dragging-card'));return el}
function setupDragDrop(){document.querySelectorAll('#board_content .list-body').forEach(body=>{body.addEventListener('dragover',e=>{e.preventDefault();body.classList.add('drag-over');const after=getDragAfterElement(body,e.clientY);const dragging=document.querySelector('.dragging-card');if(dragging){if(after==null)body.appendChild(dragging);else body.insertBefore(dragging,after)}});body.addEventListener('dragleave',e=>{if(!body.contains(e.relatedTarget))body.classList.remove('drag-over')});body.addEventListener('drop',e=>{e.preventDefault();body.classList.remove('drag-over');try{const data=JSON.parse(e.dataTransfer.getData('text/plain'));const board=AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard'));if(!board)return;const fromList=board.lists.find(l=>l.id===data.fromList);const toList=board.lists.find(l=>l.id===body.dataset.listId);if(!fromList||!toList)return;const idx=fromList.cards.findIndex(c=>c.id===data.cardId);if(idx<0)return;const card=fromList.cards.splice(idx,1)[0];card.movedAt=Date.now();if(!card.history)card.history=[];if(data.fromList!==body.dataset.listId)card.history.push({ts:Date.now(),action:'moved to "'+toList.name+'"'});const allEls=[...body.querySelectorAll('.card')];const draggingEl=document.querySelector('.dragging-card');let insertIdx=toList.cards.length;if(draggingEl){insertIdx=allEls.indexOf(draggingEl);if(insertIdx<0)insertIdx=toList.cards.length}toList.cards.splice(Math.min(insertIdx,toList.cards.length),0,card);saveApp();renderBoardLists(board)}catch(err){}})})}
function getDragAfterElement(container,y){return[...container.querySelectorAll('.card:not(.dragging-card)')].reduce((closest,child)=>{const box=child.getBoundingClientRect();const offset=y-box.top-box.height/2;if(offset<0&&offset>closest.offset)return{offset,element:child};return closest},{offset:Number.NEGATIVE_INFINITY}).element}
function showAddListForm(board){const c=document.getElementById('board_content');const btn=c.querySelector('.add-list-btn');const f=document.createElement('div');f.className='inline-form';f.innerHTML='<input type="text" placeholder="List name..."><div class="inline-form-actions"><button class="btn btn-green btn-sm">Save</button><span class="pointer" style="color:var(--text-muted)"><svg class="icon icon-sm"><use href="#icon-cancel"/></svg></span></div>';btn.replaceWith(f);f.querySelector('input').focus();f.querySelector('button').onclick=()=>{const n=f.querySelector('input').value.trim();if(!n)return;board.lists.push({id:uid(),name:n,cards:[],closed:false,creationDate:Date.now()});saveApp();renderBoardLists(board)};f.querySelector('.pointer').onclick=()=>renderBoardLists(board)}
function showAddCardForm(e,board,list){e.stopPropagation();const listEl=e.currentTarget.closest('.list');const btn=listEl.querySelector('.add-card-btn');const f=document.createElement('div');f.className='inline-form';f.style.margin='6px 8px';f.style.width='calc(100% - 16px)';f.innerHTML='<input type="text" placeholder="Card title..."><div class="inline-form-actions"><button class="btn btn-green btn-sm">Save</button><span class="pointer" style="color:var(--text-muted)"><svg class="icon icon-sm"><use href="#icon-cancel"/></svg></span></div>';btn.replaceWith(f);f.querySelector('input').focus();f.querySelector('button').onclick=()=>{const n=f.querySelector('input').value.trim();if(!n)return;list.cards.push({id:uid(),name:n,desc:'',subcards:[],attachments:[],cover:-1,closed:false,creationDate:Date.now(),movedAt:null,history:[{ts:Date.now(),action:'created'}]});saveApp();renderBoardLists(board)};f.querySelector('.pointer').onclick=()=>renderBoardLists(board)}
function archiveList(bId,lId){const b=AppData.boards.find(x=>x.id===bId);if(b){const l=b.lists.find(x=>x.id===lId);if(l){l.closed=true;saveApp();renderBoardLists(b)}}}
function toggleStar(e){e.stopPropagation();const id=e.currentTarget.dataset.id;const b=AppData.boards.find(x=>x.id===id);if(b){b.star=!b.star;saveApp();e.currentTarget.classList.toggle('starred',b.star);renderBoards()}}
let currentCardId=null,currentListId=null;
function getCard(cid,lid){const b=AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard'));if(!b)return null;const l=b.lists.find(x=>x.id===lid);return l?l.cards.find(x=>x.id===cid):null}
function openCardPopup(cid,lid,e){if(e)e.stopPropagation();currentCardId=cid;currentListId=lid;const card=getCard(cid,lid);if(!card)return;const b=AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard'));const l=b.lists.find(x=>x.id===lid);document.getElementById('card_popup_title').textContent=card.name;document.getElementById('card_popup_list').textContent='in "'+l.name+'"';document.getElementById('card_popup_desc').textContent=card.desc||'No description';document.getElementById('card_popup_history').innerHTML=(card.history||[]).map(h=>`<div>${fmtDateTime(h.ts)}: ${h.action}</div>`).join('');renderAttachmentsPopup(card);renderSubcardsPopup(card);showPopup('popup_card_display')}
function renderAttachmentsPopup(card){const el=document.getElementById('card_popup_attachments');if(!card.attachments||!card.attachments.length){el.innerHTML='<em style="color:var(--text-muted);font-size:12px">No attachments</em>';return}el.innerHTML=card.attachments.map((a,i)=>`<div class="attachment-item"><div class="attachment-thumb"><img src="${a.data}"/></div><div class="attachment-info"><div class="att-name">${a.name}</div><div class="attachment-actions"><a onclick="setCover(${i})">${card.cover===i?'Remove Cover':'Make Cover'}</a><a class="del" onclick="deleteAttachment(${i})">Del</a></div></div></div>`).join('')}
function uploadAttachment(e){const files=e.target.files;const card=getCard(currentCardId,currentListId);if(!card)return;if(!card.attachments)card.attachments=[];for(let i=0;i<files.length;i++){if(!files[i].type.match('image.*'))continue;const r=new FileReader();r.onload=(f=>ev=>{card.attachments.push({data:ev.target.result,name:f.name,date:new Date().toLocaleString()});saveApp();renderAttachmentsPopup(card);renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))})(files[i]);r.readAsDataURL(files[i])}e.target.value=''}
function setCover(i){const card=getCard(currentCardId,currentListId);if(!card)return;card.cover=card.cover===i?-1:i;saveApp();renderAttachmentsPopup(card);renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))}
function deleteAttachment(i){const card=getCard(currentCardId,currentListId);if(!card)return;card.attachments.splice(i,1);if(card.cover>=card.attachments.length)card.cover=-1;saveApp();renderAttachmentsPopup(card);renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))}
function renderSubcardsPopup(card){const el=document.getElementById('card_popup_subcards');if(!card.subcards||!card.subcards.length){el.innerHTML='<em style="color:var(--text-muted);font-size:12px">No subcards</em>';return}el.innerHTML=card.subcards.filter(s=>!s.closed).map(s=>`<div style="padding:5px 8px;background:var(--bg-hover);border-radius:3px;margin:3px 0;font-size:12px;display:flex;justify-content:space-between"><span>${s.name}</span><span class="pointer" style="color:var(--btn-danger)" onclick="deleteSubcard('${s.id}')"><svg class="icon icon-sm"><use href="#icon-cancel"/></svg></span></div>`).join('')}
function showAddSubcardForm(){document.getElementById('subcard_form_area').classList.remove('no-display');document.getElementById('subcard_input').focus()}
function addSubcard(){const n=document.getElementById('subcard_input').value.trim();if(!n)return;const card=getCard(currentCardId,currentListId);if(!card)return;if(!card.subcards)card.subcards=[];card.subcards.push({id:uid(),name:n,closed:false,creationDate:Date.now()});saveApp();renderSubcardsPopup(card);document.getElementById('subcard_input').value='';document.getElementById('subcard_form_area').classList.add('no-display');renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))}
function deleteSubcard(sid){const card=getCard(currentCardId,currentListId);if(!card)return;card.subcards=card.subcards.filter(s=>s.id!==sid);saveApp();renderSubcardsPopup(card);renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))}
function archiveCardFromPopup(){const card=getCard(currentCardId,currentListId);if(card){card.closed=true;saveApp();closePopups();renderBoardLists(AppData.boards.find(x=>x.id===localStorage.getItem('currentBoard')))}}
let projectsViewMode='table';
function setProjectsView(mode,btn){projectsViewMode=mode;document.querySelectorAll('#view-projects .view-toggle button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderProjects()}
function renderProjects(){
if(projectsViewMode==='table'){document.getElementById('projects_table_view').classList.remove('no-display');document.getElementById('projects_grid_view').classList.add('no-display');const tb=document.getElementById('projects_table_body');tb.innerHTML='';AppData.projects.forEach(p=>{const bn=p.boardId?(AppData.boards.find(b=>b.id===p.boardId)||{}).name||'-':'-';tb.innerHTML+=`<tr><td><strong>${p.title}</strong></td><td>${p.owner}</td><td>${fmtDate(p.dueDate)}</td><td>${bn}</td><td>${fmtDate(p.creationDate)}</td><td class="crud-actions"><button onclick="editProject('${p.id}')">Edit</button><button class="del" onclick="deleteProject('${p.id}')">Del</button></td></tr>`})}
else{document.getElementById('projects_table_view').classList.add('no-display');const gv=document.getElementById('projects_grid_view');gv.classList.remove('no-display');gv.innerHTML='';AppData.projects.forEach(p=>{const el=document.createElement('div');el.className='grid-card';el.onclick=()=>editProject(p.id);el.innerHTML=`<div class="grid-card-actions"><button onclick="event.stopPropagation();editProject('${p.id}')">Edit</button><button onclick="event.stopPropagation();deleteProject('${p.id}')">Del</button></div><div><div class="grid-card-title">${p.title}</div><div class="grid-card-desc">${p.desc||''}</div></div><div class="grid-card-meta"><span>${p.owner}</span>${p.dueDate?'<span>'+fmtDate(p.dueDate)+'</span>':''}</div>`;gv.appendChild(el)})}
}
function showProjectForm(p){document.getElementById('project_form_title').textContent=p?'Edit Project':'New Project';const f=document.querySelector('#popup_project_form form');f.reset();f.pid.value=p?p.id:'';if(p){f.ptitle.value=p.title;f.pdesc.value=p.desc||'';f.powner.value=p.owner;f.pdue.value=p.dueDate||''}const sel=document.getElementById('project_board_select');sel.innerHTML='<option value="">None</option>'+AppData.boards.filter(b=>!b.closed).map(b=>`<option value="${b.id}">${b.name}</option>`).join('');if(p)f.pboard.value=p.boardId||'';showPopup('popup_project_form')}
function saveProject(e){e.preventDefault();const f=e.target;const d={title:f.ptitle.value,desc:f.pdesc.value,owner:f.powner.value,dueDate:f.pdue.value||null,boardId:f.pboard.value||null};if(f.pid.value){const p=AppData.projects.find(x=>x.id===f.pid.value);if(p)Object.assign(p,d)}else AppData.projects.push({id:uid(),creationDate:Date.now(),...d});saveApp();closePopups();renderProjects()}
function editProject(id){showProjectForm(AppData.projects.find(x=>x.id===id))}
function deleteProject(id){if(confirm('Delete?')){AppData.projects=AppData.projects.filter(x=>x.id!==id);saveApp();renderProjects()}}
let tasksViewMode='table';
function setTasksView(mode,btn){tasksViewMode=mode;document.querySelectorAll('#view-tasks .view-toggle button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderTasks()}
function renderTasks(){
const sc={todo:'#f2d600',doing:'#0079bf',done:'#61bd4f'};
if(tasksViewMode==='table'){document.getElementById('tasks_table_view').classList.remove('no-display');document.getElementById('tasks_grid_view').classList.add('no-display');const tb=document.getElementById('tasks_table_body');tb.innerHTML='';AppData.tasks.forEach(t=>{tb.innerHTML+=`<tr><td><strong>${t.title}</strong>${t.type==='aux'?' <small style="color:var(--text-muted)">[aux]</small>':''}</td><td>${t.owner}</td><td>${fmtDate(t.dueDate)}</td><td><span style="background:${sc[t.status]||'#ccc'};color:#fff;padding:2px 8px;border-radius:10px;font-size:11px">${t.status}</span></td><td>${fmtMin(t.trackedSeconds||0)}</td><td class="crud-actions"><button onclick="editTask('${t.id}')">Edit</button><button class="del" onclick="deleteTask('${t.id}')">Del</button></td></tr>`})}
else{document.getElementById('tasks_table_view').classList.add('no-display');const gv=document.getElementById('tasks_grid_view');gv.classList.remove('no-display');gv.innerHTML='';AppData.tasks.forEach(t=>{const el=document.createElement('div');el.className='grid-card';el.style.background=sc[t.status]||'var(--board-bg)';el.onclick=()=>editTask(t.id);el.innerHTML=`<div class="grid-card-actions"><button onclick="event.stopPropagation();editTask('${t.id}')">Edit</button><button onclick="event.stopPropagation();deleteTask('${t.id}')">Del</button></div><div><div class="grid-card-title">${t.title}</div><div class="grid-card-desc">${t.desc||''}</div></div><div class="grid-card-meta"><span>${t.status}</span><span>${fmtMin(t.trackedSeconds||0)}</span><span>${t.type==='aux'?'aux':'work'}</span></div>`;gv.appendChild(el)})}
}
function showTaskForm(t){document.getElementById('task_form_title').textContent=t?'Edit Task':'New Task';const f=document.querySelector('#popup_task_form form');f.reset();f.tid.value=t?t.id:'';if(t){f.ttitle.value=t.title;f.tdesc.value=t.desc||'';f.towner.value=t.owner;f.tdue.value=t.dueDate||'';f.tstatus.value=t.status;f.ttype.value=t.type||'work'}showPopup('popup_task_form')}
function saveTask(e){e.preventDefault();const f=e.target;const d={title:f.ttitle.value,desc:f.tdesc.value,owner:f.towner.value,dueDate:f.tdue.value||null,status:f.tstatus.value,type:f.ttype.value};if(f.tid.value){const t=AppData.tasks.find(x=>x.id===f.tid.value);if(t)Object.assign(t,d)}else AppData.tasks.push({id:uid(),creationDate:Date.now(),trackedSeconds:0,...d});saveApp();closePopups();renderTasks()}
function editTask(id){showTaskForm(AppData.tasks.find(x=>x.id===id))}
function deleteTask(id){if(confirm('Delete?')){AppData.tasks=AppData.tasks.filter(x=>x.id!==id);saveApp();renderTasks()}}
let calYear=new Date().getFullYear(),calMonth=new Date().getMonth(),calView='month';
const MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
function renderCalendar(){document.getElementById('cal_title').textContent=calView==='month'?`${MONTHS[calMonth]} ${calYear}`:`${calYear}`;if(calView==='month')renderMonthView();else renderYearView();renderCalSidebar()}
function renderMonthView(){const g=document.getElementById('cal_grid');const days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];let h='<div class="cal-month-grid">';days.forEach(d=>h+=`<div class="cal-day-header">${d}</div>`);const first=new Date(calYear,calMonth,1).getDay();const dim=new Date(calYear,calMonth+1,0).getDate();const pd=new Date(calYear,calMonth,0).getDate();const today=new Date();for(let i=first-1;i>=0;i--)h+=`<div class="cal-day other-month"><div class="day-num">${pd-i}</div></div>`;for(let d=1;d<=dim;d++){const ds=`${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const isT=today.getFullYear()===calYear&&today.getMonth()===calMonth&&today.getDate()===d;h+=`<div class="cal-day${isT?' today':''}" onclick="showEventForm('${ds}')"><div class="day-num">${d}</div></div>`}const total=first+dim;const rem=7-(total%7);if(rem<7)for(let i=1;i<=rem;i++)h+=`<div class="cal-day other-month"><div class="day-num">${i}</div></div>`;h+='</div>';g.innerHTML=h}
function renderYearView(){const g=document.getElementById('cal_grid');const sm=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];let h='<div class="cal-grid-year">';for(let m=0;m<12;m++){const dim=new Date(calYear,m+1,0).getDate();const first=new Date(calYear,m,1).getDay();const today=new Date();let mini='';for(let i=0;i<first;i++)mini+='<div class="mday"></div>';for(let d=1;d<=dim;d++){const ds=`${calYear}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const isT=today.getFullYear()===calYear&&today.getMonth()===m&&today.getDate()===d;const hasEv=AppData.events.some(ev=>ev.date===ds);mini+=`<div class="mday${isT?' mtoday':''}${hasEv?' mhas-event':''}">${d}</div>`}h+=`<div class="cal-mini-month" onclick="calMonth=${m};setCalView('month')"><h4>${sm[m]}</h4><div class="cal-mini-grid">${mini}</div></div>`}h+='</div>';g.innerHTML=h}
function renderCalSidebar(){const l=document.getElementById('cal_events_list');const evts=AppData.events.filter(ev=>{const d=new Date(ev.date);return calView==='month'?(d.getFullYear()===calYear&&d.getMonth()===calMonth):d.getFullYear()===calYear}).sort((a,b)=>a.date.localeCompare(b.date));if(!evts.length){l.innerHTML='<em style="color:var(--text-muted);font-size:12px">No events</em>';return}l.innerHTML=evts.map(ev=>`<div class="cal-event-item" onclick="editEvent('${ev.id}')"><div class="ev-title">${ev.title}</div><div class="ev-date">${fmtDate(ev.date)}</div><div class="ev-owner">${ev.owner}</div></div>`).join('')}
function calNav(dir){if(calView==='month'){calMonth+=dir;if(calMonth>11){calMonth=0;calYear++}if(calMonth<0){calMonth=11;calYear--}}else calYear+=dir;renderCalendar()}
function calToday(){const t=new Date();calYear=t.getFullYear();calMonth=t.getMonth();renderCalendar()}
function setCalView(v,btn){calView=v;document.querySelectorAll('.cal-view-toggle button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderCalendar()}
function showEventForm(ds){const f=document.querySelector('#popup_event_form form');f.reset();f.eid.value='';document.getElementById('event_date_input').value=ds;showPopup('popup_event_form')}
function editEvent(id){const ev=AppData.events.find(x=>x.id===id);if(!ev)return;const f=document.querySelector('#popup_event_form form');f.reset();f.eid.value=ev.id;f.etitle.value=ev.title;f.edesc.value=ev.desc||'';f.eowner.value=ev.owner;f.edate.value=ev.date;showPopup('popup_event_form')}
function saveEvent(e){e.preventDefault();const f=e.target;const d={title:f.etitle.value,desc:f.edesc.value,owner:f.eowner.value,date:f.edate.value};if(f.eid.value){const ev=AppData.events.find(x=>x.id===f.eid.value);if(ev)Object.assign(ev,d)}else AppData.events.push({id:uid(),creationDate:Date.now(),...d});saveApp();closePopups();renderCalendar()}
let pomoInterval=null,pomoSeconds=1500,pomoRunning=false,pomoMode='work',pomoSessionCount=0,pomoCurrentTaskId=null,pomoSessionStart=null;
function pomoPopulateSelects(){const ws=document.getElementById('pomo_task_select');const bs=document.getElementById('pomo_break_task_select');ws.innerHTML='<option value="">-- Select task --</option>'+AppData.tasks.filter(t=>t.type==='work'||!t.type).map(t=>`<option value="${t.id}">${t.title}</option>`).join('');bs.innerHTML='<option value="">-- No auxiliary task --</option>'+AppData.tasks.filter(t=>t.type==='aux').map(t=>`<option value="${t.id}">${t.title}</option>`).join('');pomoRenderLog()}
function pomoTaskSelected(){pomoCurrentTaskId=document.getElementById('pomo_task_select').value;const t=AppData.tasks.find(x=>x.id===pomoCurrentTaskId);document.getElementById('pomo_substatus').textContent=t?`Working on: ${t.title}`:'Select a task to begin'}
function pomoUpdateDisplay(){document.getElementById('pomo_timer').textContent=`${Math.floor(pomoSeconds/60).toString().padStart(2,'0')}:${(pomoSeconds%60).toString().padStart(2,'0')}`}
function pomoUpdateProgress(){const dots=document.querySelectorAll('#pomo_progress .pomo-dot');dots.forEach((d,i)=>{d.className='pomo-dot';if(i<pomoSessionCount)d.classList.add('done');if(i===pomoSessionCount&&pomoMode==='work')d.classList.add('current')})}
function pomoStart(){if(pomoRunning)return;if(pomoMode==='work'&&!pomoCurrentTaskId){alert('Select a work task first.');return}pomoRunning=true;pomoSessionStart=Date.now();document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-pause"/></svg> Running';pomoInterval=setInterval(()=>{pomoSeconds--;pomoUpdateDisplay();if(pomoSeconds<=0){clearInterval(pomoInterval);pomoRunning=false;const elapsed=Math.round((Date.now()-pomoSessionStart)/1000);if(pomoMode==='work'){if(pomoCurrentTaskId){const t=AppData.tasks.find(x=>x.id===pomoCurrentTaskId);if(t)t.trackedSeconds=(t.trackedSeconds||0)+elapsed}AppData.pomodoroLog.push({ts:Date.now(),taskId:pomoCurrentTaskId,taskName:(AppData.tasks.find(x=>x.id===pomoCurrentTaskId)||{}).title||'',seconds:elapsed,type:'work'});pomoSessionCount++;const max=parseInt(document.getElementById('pomo_sessions').value)||4;if(pomoSessionCount>=max){pomoMode='longbreak';pomoSeconds=(parseInt(document.getElementById('pomo_long_break').value)||15)*60;document.getElementById('pomo_status').textContent='Long Break';pomoSessionCount=0}else{pomoMode='shortbreak';pomoSeconds=(parseInt(document.getElementById('pomo_short_break').value)||5)*60;document.getElementById('pomo_status').textContent='Short Break'}const bt=document.getElementById('pomo_break_task_select').value;document.getElementById('pomo_substatus').textContent=bt?`Break: ${(AppData.tasks.find(x=>x.id===bt)||{}).title||''}`:'Relax!'}else{const bt=document.getElementById('pomo_break_task_select').value;if(bt){const t=AppData.tasks.find(x=>x.id===bt);if(t)t.trackedSeconds=(t.trackedSeconds||0)+elapsed;AppData.pomodoroLog.push({ts:Date.now(),taskId:bt,taskName:(AppData.tasks.find(x=>x.id===bt)||{}).title||'',seconds:elapsed,type:'break'})}pomoMode='work';pomoSeconds=(parseInt(document.getElementById('pomo_work').value)||25)*60;document.getElementById('pomo_status').textContent='Work Session';pomoTaskSelected()}saveApp();pomoUpdateDisplay();pomoUpdateProgress();pomoRenderLog();document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-play"/></svg> Start'}},1000)}
function pomoPause(){clearInterval(pomoInterval);pomoRunning=false;document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-play"/></svg> Start'}
function pomoReset(){clearInterval(pomoInterval);pomoRunning=false;pomoMode='work';pomoSessionCount=0;pomoSeconds=(parseInt(document.getElementById('pomo_work').value)||25)*60;document.getElementById('pomo_status').textContent='Work Session';pomoTaskSelected();pomoUpdateDisplay();pomoUpdateProgress();document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-play"/></svg> Start'}
function pomoRenderLog(){const today=new Date().toDateString();const logs=AppData.pomodoroLog.filter(l=>new Date(l.ts).toDateString()===today);const el=document.getElementById('pomo_log_list');if(!logs.length){el.innerHTML='<em style="font-size:12px;color:var(--text-muted)">No sessions yet</em>';return}el.innerHTML=logs.map(l=>`<div class="pomo-log-item">${new Date(l.ts).toLocaleTimeString()} · <span class="pomo-log-dot ${l.type==='work'?'work':'aux'}"></span> ${l.taskName||'—'} · ${fmtMin(l.seconds)}</div>`).join('')}
function toggleDataMenu(e){e.stopPropagation();document.getElementById('dataDropdown').classList.toggle('visible');document.getElementById('themeDropdown').classList.remove('visible')}
document.addEventListener('click',e=>{if(!e.target.closest('.header-btn')){document.getElementById('dataDropdown').classList.remove('visible');document.getElementById('themeDropdown').classList.remove('visible')}});
function exportData(format){document.getElementById('dataDropdown').classList.remove('visible');const ts=new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);let content,filename,mime;if(format==='json'){content=JSON.stringify(AppData,null,2);filename=`drello-export-${ts}.json`;mime='application/json'}else if(format==='csv'){let rows=[['board_id','board_name','list_id','list_name','card_id','card_name'].join(',')];AppData.boards.forEach(b=>{(b.lists||[]).forEach(l=>{(l.cards||[]).forEach(c=>{rows.push([b.id,b.name,l.id,l.name,c.id,c.name].join(','))})})});content=rows.join('\n');filename=`drello-export-${ts}.csv`;mime='text/csv'}else{content=JSON.stringify(AppData);filename=`drello-export-${ts}.blob`;mime='application/octet-stream'}const blob=new Blob([content],{type:mime});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click()}
let __importMode='add';
function showImportDialog(mode){__importMode=mode;document.getElementById('dataDropdown').classList.remove('visible');document.getElementById('import_mode_desc').textContent={add:'Added to existing.',replace:'All replaced.',merge:'Merged by ID.'}[mode];showPopup('popup_import')}
function performImport(){const file=document.getElementById('import_file').files[0];if(!file)return;const r=new FileReader();r.onload=e=>{try{const data=JSON.parse(e.target.result);if(__importMode==='replace')AppData=data;else if(__importMode==='add'){Object.keys(data).forEach(k=>{if(Array.isArray(data[k])&&Array.isArray(AppData[k]))AppData[k]=[...AppData[k],...data[k]]})}else{Object.keys(data).forEach(k=>{if(Array.isArray(data[k])&&Array.isArray(AppData[k]))data[k].forEach(item=>{if(item.id&&!AppData[k].some(e=>e.id===item.id))AppData[k].push(item)})})}normalizeData();saveApp();closePopups();alert('Import successful!');showView('dashboard')}catch(err){alert('Import error: '+err.message)}};r.readAsText(file)}
let __currentPopup=null;
function showPopup(id){if(__currentPopup)__currentPopup.classList.remove('visible');const p=document.getElementById(id);p.classList.add('visible');__currentPopup=p;document.getElementById('overlay').classList.add('visible')}
function closePopups(e,force){if(!__currentPopup)return;if(!force&&e&&__currentPopup.contains(e.target))return;__currentPopup.classList.remove('visible');__currentPopup=null;document.getElementById('overlay').classList.remove('visible')}
document.getElementById('overlay').addEventListener('click',e=>{if(e.target.id==='overlay')closePopups(null,true)});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closePopups(null,true)});
function closeCurrentBoard(){const id=localStorage.getItem('currentBoard');const b=AppData.boards.find(x=>x.id===id);if(b&&confirm('Close board?')){b.closed=true;saveApp();showView('boards');toggleAside()}}
normalizeData();
document.getElementById('footerYear').textContent=new Date().getFullYear();
renderDashboard();
pomoUpdateDisplay();
pomoUpdateProgress();
</script>
<script>
(function(){
const USERS_KEY='drello_users_v1';
const SESSION_KEY='drello_session_v1';
const ATTEMPTS_KEY='drello_login_attempts_v1';
const PBKDF2_ITERATIONS=600000;
let appUsers=store.get(USERS_KEY,[]);
let currentUserData=null;
const $=s=>document.querySelector(s);
const $$=s=>Array.from(document.querySelectorAll(s));
const esc=v=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
const todayISO=()=>new Date().toISOString().slice(0,10);
const monthISO=()=>todayISO().slice(0,7);
const numOrNull=v=>{if(v===''||v===null||typeof v==='undefined')return null;const n=Number(v);return Number.isFinite(n)?n:null;};
const fmtMoney=(v,c)=>{try{return new Intl.NumberFormat(undefined,{style:'currency',currency:c||'USD'}).format(Number(v||0))}catch(e){return String(v||0)}};
function statBox(label,value){return '<div class="stat-box"><div class="stat-value">'+esc(value)+'</div><div class="stat-label">'+esc(label)+'</div></div>';}
function bytesToHex(bytes){return Array.from(new Uint8Array(bytes)).map(b=>b.toString(16).padStart(2,'0')).join('');}
function hexToBytes(hex){const clean=String(hex||'');const out=new Uint8Array(clean.length/2);for(let i=0;i<out.length;i++)out[i]=parseInt(clean.slice(i*2,i*2+2),16);return out;}
async function deriveBits(password,salt,iterations){const keyMaterial=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);return crypto.subtle.deriveBits({name:'PBKDF2',salt:salt,iterations:iterations,hash:'SHA-256'},keyMaterial,256);}
function validatePassword(p){if(!p||p.length<8)throw new Error('Password must be at least 8 characters long.');if(!/[A-Za-z]/.test(p)||!/\d/.test(p))throw new Error('Password must contain letters and numbers.');}
async function makePasswordProof(password){validatePassword(password);const salt=crypto.getRandomValues(new Uint8Array(16));const hash=await deriveBits(password,salt,PBKDF2_ITERATIONS);return {algo:'PBKDF2-SHA256',iterations:PBKDF2_ITERATIONS,salt:bytesToHex(salt),hash:bytesToHex(hash)};}
async function verifyPasswordProof(password,proof){if(!proof||!proof.salt||!proof.hash)return false;const salt=hexToBytes(proof.salt);const iterations=Number(proof.iterations||PBKDF2_ITERATIONS);const hash=await deriveBits(password,salt,iterations);return bytesToHex(hash)===proof.hash;}
function saveUsersStore(){store.set(USERS_KEY,appUsers)}
function getUserById(id){return appUsers.find(u=>u.id===id)}
function getUserByIdentifier(ident){const q=String(ident||'').trim().toLowerCase();return appUsers.find(u=>u.username?.toLowerCase()===q||String(u.email||'').toLowerCase()===q)}
function findDuplicateUser(username,email,exceptId){const u=String(username||'').trim().toLowerCase();const e=String(email||'').trim().toLowerCase();return appUsers.find(x=>{if(x.id===exceptId)return false;if(x.username?.toLowerCase()===u)return true;if(e&&String(x.email||'').toLowerCase()===e)return true;return false});}
function setSession(user){sessionStorage.setItem(SESSION_KEY,JSON.stringify({userId:user.id,expiresAt:Date.now()+8*60*60*1000}))}
function getSession(){try{const d=JSON.parse(sessionStorage.getItem(SESSION_KEY));if(!d||!d.userId||!d.expiresAt)return null;if(d.expiresAt<Date.now()){sessionStorage.removeItem(SESSION_KEY);return null}return d}catch(e){return null}}
function checkAttempts(id){const all=store.get(ATTEMPTS_KEY,{});const rec=all[id];if(rec&&rec.until&&rec.until>Date.now())throw new Error('Too many failed attempts. Try again in '+Math.ceil((rec.until-Date.now())/1000)+'s.')}
function failAttempts(id){const all=store.get(ATTEMPTS_KEY,{});const rec=all[id]||{count:0};rec.count++;if(rec.count>=5){rec.until=Date.now()+30000;rec.count=0}all[id]=rec;store.set(ATTEMPTS_KEY,all)}
function resetAttempts(id){const all=store.get(ATTEMPTS_KEY,{});delete all[id];store.set(ATTEMPTS_KEY,all)}
const authOverlay=$('#authOverlay'),authTitle=$('#authTitle'),authForm=$('#authForm'),authNameWrap=$('#authNameWrap'),authName=$('#authName'),authIdentifier=$('#authIdentifier'),authPassword=$('#authPassword'),authConfirmWrap=$('#authConfirmWrap'),authConfirm=$('#authConfirm'),authError=$('#authError'),authSubmit=$('#authSubmit');
let authMode='login';
function setAuthMode(mode){authMode=mode;const setup=mode==='setup';authNameWrap.classList.toggle('auth-hidden',!setup);authConfirmWrap.classList.toggle('auth-hidden',!setup);authTitle.textContent=setup?'Create administrator':'Sign in';authSubmit.textContent=setup?'Create account':'Sign in';authError.textContent='';if(setup){authName.value=authName.value||'Drello User';authIdentifier.value=authIdentifier.value||'user@drello.app'}}
async function handleAuthSubmit(e){
e.preventDefault();authError.textContent='';
if(!window.crypto?.subtle){authError.textContent='Web Crypto is unavailable. Serve this file over localhost or HTTPS.';return}
try{
const password=authPassword.value;
if(authMode==='setup'){
if(password!==authConfirm.value)throw new Error('Passwords do not match.');
let ident=authIdentifier.value.trim();if(!ident)throw new Error('Username or email is required.');
let username,email;if(ident.includes('@')){email=ident;username=ident.split('@')[0]}else{username=ident;email=''}
username=username.replace(/[^a-z0-9_.-]/gi,'').toLowerCase()||'admin';
if(findDuplicateUser(username,email,null))throw new Error('User already exists.');
const auth=await makePasswordProof(password);
const user={id:uid(),name:authName.value.trim()||'Drello User',username:username,email:email,role:'admin',active:true,createdAt:Date.now(),auth:auth};
appUsers.push(user);saveUsersStore();setSession(user);currentUserData=user;unlock();
}else{
const ident=authIdentifier.value.trim();checkAttempts(ident.toLowerCase());
const user=getUserByIdentifier(ident);
if(!user||!user.active||!user.auth){failAttempts(ident.toLowerCase());throw new Error('Invalid credentials.')}
const ok=await verifyPasswordProof(password,user.auth);
if(!ok){failAttempts(ident.toLowerCase());throw new Error('Invalid credentials.')}
resetAttempts(ident.toLowerCase());setSession(user);currentUserData=user;unlock();
}
}catch(err){authError.textContent=err.message||'Authentication failed.'}
}
function initials(name){return String(name||'').trim().split(/\s+/).slice(0,2).map(x=>x[0]||'').join('').toUpperCase()||'U'}
function applyCurrentUserUI(){
if(!currentUserData)return;
const av=initials(currentUserData.name);
const first=String(currentUserData.name||'').split(' ')[0]||'User';
const ha=$('#headerAvatar'),hn=$('#headerUserName'),aa=$('#asideAvatar'),an=$('#asideUserName'),ae=$('#asideUserEmail');
if(ha)ha.textContent=av;if(hn)hn.textContent=first;if(aa)aa.textContent=av;if(an)an.textContent=currentUserData.name;if(ae)ae.textContent=currentUserData.email||'';
}
function updateAdminClass(){document.body.classList.toggle('drello-user-admin',!!(currentUserData&&currentUserData.role==='admin'))}
function unlock(){
document.body.classList.remove('drello-auth-locked');
document.body.classList.add('drello-authenticated');
updateAdminClass();
authOverlay.classList.add('auth-hidden');
applyCurrentUserUI();
upgradeOwnerInputs();
refreshOwnerSelects();
if(typeof renderDashboard==='function')renderDashboard();
if(typeof renderProjects==='function')renderProjects();
if(typeof renderTasks==='function')renderTasks();
if(typeof renderCalendar==='function')renderCalendar();
if(typeof pomoPopulateSelects==='function')pomoPopulateSelects();
renderHealth();renderFinance();renderUsers();
}
function lock(){
document.body.classList.add('drello-auth-locked');
document.body.classList.remove('drello-authenticated','drello-user-admin');
authOverlay.classList.remove('auth-hidden');
if(appUsers.length===0)setAuthMode('setup');else setAuthMode('login');
authPassword.value='';authConfirm.value='';
}
window.authLogout=function(){saveApp();sessionStorage.removeItem(SESSION_KEY);currentUserData=null;if(typeof closePopups==='function')closePopups(null,true);lock();};
window.fillOwnerSelect=function(select,selected){
if(!select)return;
const active=appUsers.filter(u=>u.active);
select.innerHTML='<option value="">-- Owner --</option>'+active.map(u=>'<option value="'+esc(u.name)+'">'+esc(u.name)+'</option>').join('');
if(selected){
if(!Array.from(select.options).some(o=>o.value===selected)){const o=document.createElement('option');o.value=selected;o.textContent=selected;select.appendChild(o)}
select.value=selected;
}else if(currentUserData){select.value=currentUserData.name}
};
function upgradeOwnerInputs(){
['powner','towner','eowner'].forEach(name=>{
const input=document.querySelector('input[name='+name+']');
if(input){const sel=document.createElement('select');sel.className=input.className;sel.name=name;const val=input.value;input.replaceWith(sel);fillOwnerSelect(sel,val)}
});
}
function refreshOwnerSelects(){
const selectors='select[name=powner],select[name=towner],select[name=eowner],#health_owner,#tx_owner';
$$(selectors).forEach(s=>fillOwnerSelect(s,s.value));
}
function defaultFinance(){
return {baseCurrency:'USD',accounts:[],transactions:[],budgets:[],categories:[
{id:'cat-salary',name:'Salary',type:'income'},
{id:'cat-freelance',name:'Freelance',type:'income'},
{id:'cat-investments',name:'Investments',type:'income'},
{id:'cat-other-income',name:'Other Income',type:'income'},
{id:'cat-housing',name:'Housing',type:'expense'},
{id:'cat-food',name:'Food',type:'expense'},
{id:'cat-transport',name:'Transport',type:'expense'},
{id:'cat-health',name:'Health',type:'expense'},
{id:'cat-utilities',name:'Utilities',type:'expense'},
{id:'cat-entertainment',name:'Entertainment',type:'expense'},
{id:'cat-debt',name:'Debt',type:'expense'},
{id:'cat-savings',name:'Savings',type:'expense'},
{id:'cat-other-expense',name:'Other Expense',type:'expense'}
]};
}
window.ensureExtendedData=function(){
if(!AppData.healthRecords)AppData.healthRecords=[];
if(!AppData.finance)AppData.finance=defaultFinance();
['accounts','transactions','budgets','categories'].forEach(k=>{if(!Array.isArray(AppData.finance[k]))AppData.finance[k]=[]});
if(!AppData.finance.categories.length)AppData.finance.categories=defaultFinance().categories;
if(!AppData.finance.baseCurrency)AppData.finance.baseCurrency='USD';
AppData.tasks.forEach(t=>{if(t.type==='break')t.type='aux';if(!t.type)t.type='work'});
};
const baseNormalize=window.normalizeData;
window.normalizeData=function(){baseNormalize();ensureExtendedData();};
ensureExtendedData();saveApp();
window.taskTypeFilter='all';
window.setTaskTypeFilter=function(mode,btn){
window.taskTypeFilter=mode;
$$('.task-type-tabs button').forEach(b=>b.classList.remove('active'));
if(btn)btn.classList.add('active');
renderTasks();
};
window.renderTasks=function(){
const sc={todo:'#f2d600',doing:'#0079bf',done:'#61bd4f'};
const tasks=AppData.tasks.filter(t=>window.taskTypeFilter==='all'||t.type===window.taskTypeFilter);
if(tasksViewMode==='table'){
document.getElementById('tasks_table_view').classList.remove('no-display');
document.getElementById('tasks_grid_view').classList.add('no-display');
const tb=document.getElementById('tasks_table_body');tb.innerHTML='';
tasks.forEach(t=>{
tb.innerHTML+='<tr><td><strong>'+esc(t.title)+'</strong>'+(t.type==='aux'?' <small style="color:var(--text-muted)">[aux]</small>':'')+'</td><td>'+esc(t.owner)+'</td><td>'+fmtDate(t.dueDate)+'</td><td><span style="background:'+(sc[t.status]||'#ccc')+';color:#fff;padding:2px 8px;border-radius:10px;font-size:11px">'+esc(t.status)+'</span></td><td>'+fmtMin(t.trackedSeconds||0)+'</td><td class="crud-actions"><button onclick="editTask(\''+t.id+'\')">Edit</button><button class="del" onclick="deleteTask(\''+t.id+'\')">Del</button></td></tr>';
});
}else{
document.getElementById('tasks_table_view').classList.add('no-display');
const gv=document.getElementById('tasks_grid_view');gv.classList.remove('no-display');gv.innerHTML='';
tasks.forEach(t=>{
const el=document.createElement('div');el.className='grid-card';el.style.background=sc[t.status]||'var(--board-bg)';el.onclick=function(){editTask(t.id)};
el.innerHTML='<div class="grid-card-actions"><button onclick="event.stopPropagation();editTask(\''+t.id+'\')">Edit</button><button onclick="event.stopPropagation();deleteTask(\''+t.id+'\')">Del</button></div><div><div class="grid-card-title">'+esc(t.title)+'</div><div class="grid-card-desc">'+esc(t.desc||'')+'</div></div><div class="grid-card-meta"><span>'+esc(t.status)+'</span><span>'+fmtMin(t.trackedSeconds||0)+'</span><span>'+esc(t.type==='aux'?'aux':'work')+'</span></div>';
gv.appendChild(el);
});
}
};
window.pickAuxiliaryTasks=function(){document.getElementById('aux_file_input').click();};
window.loadSampleExercises=window.pickAuxiliaryTasks;
window.importAuxiliaryTasksFile=function(event){
const file=event.target.files[0];if(!file)return;
const r=new FileReader();
r.onload=function(e){
try{
const parsed=JSON.parse(e.target.result);
let incoming=[];
if(Array.isArray(parsed))incoming=parsed;
else if(Array.isArray(parsed.tasks))incoming=parsed.tasks;
else if(Array.isArray(parsed.auxiliaryTasks))incoming=parsed.auxiliaryTasks;
else throw new Error('Expected JSON array or object with tasks/auxiliaryTasks array.');
let added=0;
incoming.forEach(item=>{
if(!item||!item.title)return;
if(AppData.tasks.some(t=>t.title===item.title&&t.type==='aux'))return;
AppData.tasks.push({id:uid(),title:item.title,desc:(item.desc||'')+(item.duration?' ('+item.duration+')':''),owner:currentUserData?.name||'Drello User',dueDate:item.dueDate||null,status:item.status||'todo',type:'aux',creationDate:item.creationDate||Date.now(),trackedSeconds:item.trackedSeconds||0});
added++;
});
ensureExtendedData();saveApp();renderTasks();
if(document.getElementById('view-pomodoro').classList.contains('active'))pomoPopulateSelects();
alert(added+' auxiliary tasks imported.');
}catch(err){alert('Import error: '+err.message)}
};
r.readAsText(file);event.target.value='';
};
window.pomoPopulateSelects=function(){
const ws=document.getElementById('pomo_task_select'),bs=document.getElementById('pomo_break_task_select');
ws.innerHTML='<option value="">-- Select task --</option>'+AppData.tasks.filter(t=>t.type==='work').map(t=>'<option value="'+t.id+'">'+esc(t.title)+'</option>').join('');
bs.innerHTML='<option value="">-- No auxiliary task --</option>'+AppData.tasks.filter(t=>t.type==='aux').map(t=>'<option value="'+t.id+'">'+esc(t.title)+'</option>').join('');
pomoRenderLog();
};
window.pomoRenderLog=function(){
const today=new Date().toDateString();
const logs=AppData.pomodoroLog.filter(l=>new Date(l.ts).toDateString()===today);
const el=document.getElementById('pomo_log_list');
if(!logs.length){el.innerHTML='<em style="font-size:12px;color:var(--text-muted)">No sessions yet</em>';return}
el.innerHTML=logs.map(l=>'<div class="pomo-log-item">'+new Date(l.ts).toLocaleTimeString()+' · <span class="pomo-log-dot '+(l.type==='work'?'work':'aux')+'"></span> '+esc(l.taskName||'—')+' · '+fmtMin(l.seconds)+'</div>').join('');
};
window.pomoStart=function(){
if(pomoRunning)return;
if(pomoMode==='work'&&!pomoCurrentTaskId){alert('Select a work task first.');return}
pomoRunning=true;pomoSessionStart=Date.now();
document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-pause"/></svg> Running';
pomoInterval=setInterval(function(){
pomoSeconds--;pomoUpdateDisplay();
if(pomoSeconds<=0){
clearInterval(pomoInterval);pomoRunning=false;
const elapsed=Math.round((Date.now()-pomoSessionStart)/1000);
if(pomoMode==='work'){
if(pomoCurrentTaskId){const t=AppData.tasks.find(x=>x.id===pomoCurrentTaskId);if(t)t.trackedSeconds=(t.trackedSeconds||0)+elapsed}
AppData.pomodoroLog.push({ts:Date.now(),taskId:pomoCurrentTaskId,taskName:(AppData.tasks.find(x=>x.id===pomoCurrentTaskId)||{}).title||'',seconds:elapsed,type:'work'});
pomoSessionCount++;
const max=parseInt(document.getElementById('pomo_sessions').value)||4;
if(pomoSessionCount>=max){pomoMode='longbreak';pomoSeconds=(parseInt(document.getElementById('pomo_long_break').value)||15)*60;document.getElementById('pomo_status').textContent='Long Break';pomoSessionCount=0}
else{pomoMode='shortbreak';pomoSeconds=(parseInt(document.getElementById('pomo_short_break').value)||5)*60;document.getElementById('pomo_status').textContent='Short Break'}
const bt=document.getElementById('pomo_break_task_select').value;
document.getElementById('pomo_substatus').textContent=bt?('Break: '+((AppData.tasks.find(x=>x.id===bt)||{}).title||'')):'Relax!';
}else{
const bt=document.getElementById('pomo_break_task_select').value;
if(bt){const t=AppData.tasks.find(x=>x.id===bt);if(t)t.trackedSeconds=(t.trackedSeconds||0)+elapsed;AppData.pomodoroLog.push({ts:Date.now(),taskId:bt,taskName:(AppData.tasks.find(x=>x.id===bt)||{}).title||'',seconds:elapsed,type:'break'})}
pomoMode='work';pomoSeconds=(parseInt(document.getElementById('pomo_work').value)||25)*60;document.getElementById('pomo_status').textContent='Work Session';pomoTaskSelected();
}
saveApp();pomoUpdateDisplay();pomoUpdateProgress();pomoRenderLog();
document.getElementById('pomo_start_btn').innerHTML='<svg class="icon"><use href="#icon-play"/></svg> Start';
}
},1000);
};
window.editHealthById=function(id){showHealthForm(AppData.healthRecords.find(x=>x.id===id))};
window.renderHealth=function(){
const body=document.getElementById('health_table_body'),summary=document.getElementById('health_summary');
if(!body||!summary)return;
const records=[...AppData.healthRecords].sort((a,b)=>String(b.date).localeCompare(String(a.date)));
const latest=records[0];const m=monthISO();const monthRecords=records.filter(r=>String(r.date).startsWith(m));
const avg=f=>{const vals=monthRecords.map(r=>Number(r[f])).filter(Number.isFinite);return vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:null};
const sum=f=>monthRecords.map(r=>Number(r[f])).filter(Number.isFinite).reduce((a,b)=>a+b,0);
summary.innerHTML=
statBox('Latest weight',latest?.weightKg?latest.weightKg+' kg':'--')+
statBox('Latest BP',latest?.bpSys&&latest?.bpDia?latest.bpSys+'/'+latest.bpDia:'--')+
statBox('Avg sleep month',avg('sleepHours')?avg('sleepHours').toFixed(1)+' h':'--')+
statBox('Steps month',sum('steps')||'--')+
statBox('Exercise month',(sum('exerciseMinutes')||0)+' min')+
statBox('Records month',monthRecords.length);
body.innerHTML=records.map(r=>{
const bp=(r.bpSys&&r.bpDia)?(r.bpSys+'/'+r.bpDia):'--';
return '<tr><td>'+esc(r.date)+'</td><td>'+esc(r.owner||'')+'</td><td>'+esc(r.weightKg??'--')+'</td><td>'+esc(bp)+'</td><td>'+esc(r.restingHr??'--')+'</td><td>'+esc(r.sleepHours??'--')+'</td><td>'+esc(r.steps??'--')+'</td><td>'+esc(r.waterMl??'--')+'</td><td>'+esc(r.mood||'--')+'</td><td class="crud-actions"><button onclick="editHealthById(\''+r.id+'\')">Edit</button><button class="del" onclick="deleteHealthRecord(\''+r.id+'\')">Del</button></td></tr>';
}).join('');
};

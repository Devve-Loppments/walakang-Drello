$('#health_id').value=record?.id||'';
$('#health_date').value=record?.date||todayISO();
fillOwnerSelect($('#health_owner'),record?.owner||currentUserData?.name);
$('#health_weightKg').value=record?.weightKg??'';
$('#health_heightCm').value=record?.heightCm??'';
$('#health_bodyFatPct').value=record?.bodyFatPct??'';
$('#health_waistCm').value=record?.waistCm??'';
$('#health_hipCm').value=record?.hipCm??'';
$('#health_bpSys').value=record?.bpSys??'';
$('#health_bpDia').value=record?.bpDia??'';
$('#health_restingHr').value=record?.restingHr??'';
$('#health_sleepHours').value=record?.sleepHours??'';
$('#health_sleepQuality').value=record?.sleepQuality??'';
$('#health_stress').value=record?.stress??'';
$('#health_mood').value=record?.mood??'';
$('#health_waterMl').value=record?.waterMl??'';
$('#health_caloriesKcal').value=record?.caloriesKcal??'';
$('#health_proteinG').value=record?.proteinG??'';
$('#health_carbsG').value=record?.carbsG??'';
$('#health_fatG').value=record?.fatG??'';
$('#health_steps').value=record?.steps??'';

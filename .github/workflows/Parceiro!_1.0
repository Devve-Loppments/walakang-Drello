<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name ="License" content="All rights reserved, until I change my mind..." />
<title>Drello</title>
<style>
:root,[data-theme="light"]{--bg-primary:#0e74af;--bg-header:#0B5B8A;--bg-nav:#0a5a88;--bg-content:#0e74af;--bg-list:#e2e4e6;--bg-card:#ffffff;--bg-aside:#f4f5f7;--bg-footer:#0B5B8A;--bg-popup:#ffffff;--bg-hover:rgba(255,255,255,.15);--bg-input:#ffffff;--text-primary:#444;--text-header:#fff;--text-nav:rgba(255,255,255,.9);--text-card:#333;--text-muted:#888;--text-footer:rgba(255,255,255,.85);--border-color:#ddd;--border-light:#eee;--accent:#0B5B8A;--accent-hover:#094870;--btn-green:#61bd4f;--btn-green-hover:#5aac46;--btn-danger:#eb5a46;--shadow:rgba(0,0,0,.15);--overlay-bg:rgba(0,0,0,.5);--board-bg:#0E74AF;--board-hover:#0B5B8A}
[data-theme="dark"]{--bg-primary:#1a1a2e;--bg-header:#16213e;--bg-nav:#0f3460;--bg-content:#1a1a2e;--bg-list:#2a2a3e;--bg-card:#333350;--bg-aside:#22223a;--bg-footer:#16213e;--bg-popup:#2a2a3e;--bg-hover:rgba(255,255,255,.08);--bg-input:#333350;--text-primary:#e0e0e0;--text-header:#fff;--text-nav:rgba(255,255,255,.85);--text-card:#e8e8e8;--text-muted:#999;--text-footer:rgba(255,255,255,.7);--border-color:#444460;--border-light:#3a3a55;--accent:#4a90d9;--accent-hover:#3a7bc8;--btn-green:#4caf50;--btn-green-hover:#43a047;--btn-danger:#ef5350;--shadow:rgba(0,0,0,.4);--overlay-bg:rgba(0,0,0,.7);--board-bg:#2a4a7f;--board-hover:#1e3a6a}
[data-theme="ocean"]{--bg-primary:#0d3b66;--bg-header:#0a2f52;--bg-nav:#082640;--bg-content:#0d3b66;--bg-list:#e8f4f8;--bg-card:#fff;--bg-aside:#eef7fa;--bg-footer:#0a2f52;--bg-popup:#fff;--bg-hover:rgba(255,255,255,.12);--bg-input:#fff;--text-primary:#2c3e50;--text-header:#fff;--text-nav:rgba(255,255,255,.9);--text-card:#2c3e50;--text-muted:#7f8c8d;--text-footer:rgba(255,255,255,.8);--border-color:#bdc3c7;--border-light:#ecf0f1;--accent:#1abc9c;--accent-hover:#16a085;--btn-green:#27ae60;--btn-green-hover:#219a52;--btn-danger:#e74c3c;--shadow:rgba(0,0,0,.12);--overlay-bg:rgba(0,0,0,.5);--board-bg:#1a5276;--board-hover:#154360}
[data-theme="forest"]{--bg-primary:#2d5016;--bg-header:#1e3a0f;--bg-nav:#1a320d;--bg-content:#2d5016;--bg-list:#f0f4e8;--bg-card:#fff;--bg-aside:#f2f6ec;--bg-footer:#1e3a0f;--bg-popup:#fff;--bg-hover:rgba(255,255,255,.12);--bg-input:#fff;--text-primary:#334422;--text-header:#fff;--text-nav:rgba(255,255,255,.9);--text-card:#334422;--text-muted:#7a8a6a;--text-footer:rgba(255,255,255,.8);--border-color:#c5d5b5;--border-light:#e5eeda;--accent:#4a7c23;--accent-hover:#3d6a1c;--btn-green:#5d9e3a;--btn-green-hover:#4f8a30;--btn-danger:#d35400;--shadow:rgba(0,0,0,.12);--overlay-bg:rgba(0,0,0,.5);--board-bg:#3d6b1e;--board-hover:#2f5516}
[data-theme="sunset"]{--bg-primary:#c0392b;--bg-header:#96281b;--bg-nav:#7b1f14;--bg-content:#c0392b;--bg-list:#fdf2f0;--bg-card:#fff;--bg-aside:#fef5f3;--bg-footer:#96281b;--bg-popup:#fff;--bg-hover:rgba(255,255,255,.12);--bg-input:#fff;--text-primary:#4a2c2a;--text-header:#fff;--text-nav:rgba(255,255,255,.9);--text-card:#4a2c2a;--text-muted:#a0736e;--text-footer:rgba(255,255,255,.8);--border-color:#e8c4c0;--border-light:#f5e0dd;--accent:#e67e22;--accent-hover:#d35400;--btn-green:#27ae60;--btn-green-hover:#219a52;--btn-danger:#c0392b;--shadow:rgba(0,0,0,.12);--overlay-bg:rgba(0,0,0,.5);--board-bg:#d35400;--board-hover:#b34700}
*,*:before,*:after{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%}
ul{list-style:none;margin:0;padding:0}
a{color:var(--accent);text-decoration:none}
input,select,textarea,button{font-family:inherit;font-size:inherit;border:none;outline:none}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;font-size:14px;color:var(--text-primary);background:var(--bg-primary);min-height:100vh;transition:background .3s,color .3s}
.HolyGrail{display:flex;flex-direction:column;min-height:100vh}
.HolyGrail-header{background:var(--bg-header);padding:7px 15px;display:flex;align-items:center;gap:8px;flex-shrink:0;z-index:10;height:50px}
.HolyGrail-body{display:flex;flex:1;overflow:hidden;position:relative}
.HolyGrail-nav{width:56px;background:var(--bg-nav);padding:10px 0;flex-shrink:0;overflow-y:auto;display:flex;flex-direction:column}
.HolyGrail-content{flex:1;overflow:auto;padding:20px 25px;background:var(--bg-content);position:relative}
.HolyGrail-aside{width:300px;background:var(--bg-aside);flex-shrink:0;overflow-y:auto;transition:margin-right .3s;box-shadow:-2px 0 8px var(--shadow);z-index:5}
.HolyGrail-aside.collapsed{margin-right:-300px}
.HolyGrail-footer{background:var(--bg-footer);color:var(--text-footer);padding:12px 20px;text-align:center;font-size:12px;flex-shrink:0}
.HolyGrail-footer a{color:var(--text-footer);text-decoration:underline}
.nav-item{display:flex;align-items:center;justify-content:center;width:44px;height:44px;color:var(--text-nav);cursor:pointer;transition:background .15s;border-radius:6px;margin:2px auto;position:relative}
.nav-item:hover{background:var(--bg-hover)}
.nav-item.active{background:rgba(255,255,255,.2);color:#fff}
.nav-item .icon{font-size:20px}
.nav-item .nav-label{display:none}
.nav-item[data-tooltip]:hover::after{content:attr(data-tooltip);position:absolute;left:calc(100% + 8px);top:50%;transform:translateY(-50%);background:#222;color:#fff;padding:4px 10px;border-radius:4px;font-size:11px;white-space:nowrap;z-index:999;pointer-events:none}
.nav-divider{height:1px;background:rgba(255,255,255,.1);margin:6px 10px}
@media(max-width:700px){
.HolyGrail-body{flex-direction:column;overflow:visible}
.HolyGrail-nav{width:100%;flex-direction:row;align-items:center;overflow-x:auto;height:48px;padding:0}
.HolyGrail-nav .nav-item{width:48px;height:48px;margin:0;border-radius:0;flex-shrink:0}
.HolyGrail-nav .nav-divider{display:none}
.HolyGrail-nav .nav-item[data-tooltip]:hover::after{left:50%;top:calc(100% + 6px);transform:translateX(-50%)}
.HolyGrail-content{padding:12px}
.HolyGrail-aside{position:fixed;top:0;right:0;width:280px;height:100vh;z-index:200;transform:translateX(100%);transition:transform .3s}
.HolyGrail-aside.show-mobile{transform:translateX(0)}
.HolyGrail-aside.collapsed{transform:translateX(100%);margin-right:0}
.header-search{display:none!important}
.header-btn .btn-label{display:none}
.header-profile span{display:none}
.boards-list{grid-template-columns:1fr!important}
.cal-body{flex-direction:column}
.cal-sidebar{width:100%!important;max-height:180px;border-right:none;border-bottom:1px solid var(--border-light);padding-right:0;padding-bottom:10px;margin-bottom:10px}
.cal-month-grid{font-size:11px}
.cal-day{min-height:50px!important;padding:3px 4px!important}
.cal-day .day-num{width:20px;height:20px;font-size:11px}
.cal-day-header{padding:6px 2px;font-size:10px}
.cal-grid-year{grid-template-columns:repeat(2,1fr)!important;gap:8px}
.cal-container{padding:12px!important}
.cal-header{flex-direction:column;align-items:flex-start;gap:8px}
.cal-nav{flex-wrap:wrap}
.dash-grid{grid-template-columns:1fr!important}
}
@media(max-width:480px){
.cal-grid-year{grid-template-columns:1fr!important}
.cal-day{min-height:40px!important}
.pomodoro-timer{font-size:48px}
.pomo-settings{grid-template-columns:1fr}
}
.icon{display:inline-block;width:1em;height:1em;stroke-width:0;stroke:currentColor;fill:currentColor;vertical-align:-.125em}
.icon-sm{width:.875em;height:.875em}.icon-lg{width:1.5em;height:1.5em}.icon-xl{width:2em;height:2em}
.header-logo{display:flex;align-items:center;padding:0 12px;height:32px;background:rgba(255,255,255,.1);border-radius:3px;font-weight:bold;color:var(--text-header);letter-spacing:1px;font-size:14px;cursor:pointer;flex-shrink:0}
.header-logo:hover{background:rgba(255,255,255,.25)}
.header-search{position:relative;flex:0 1 220px;height:32px;background:rgba(255,255,255,.2);border-radius:3px;transition:all .2s}
.header-search input{width:100%;height:100%;background:transparent;color:var(--text-header);padding:0 12px 0 32px;font-size:13px;border-radius:3px}
.header-search input::placeholder{color:rgba(255,255,255,.7)}
.header-search .icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,.7)}
.header-search.focused{flex:0 1 320px;background:var(--bg-popup)}
.header-search.focused input{color:var(--text-primary)}
.header-search.focused input::placeholder{color:var(--text-muted)}
.header-search.focused .icon{color:var(--text-muted)}
.header-right{display:flex;align-items:center;gap:6px;margin-left:auto}
.header-btn{background:rgba(255,255,255,.2);height:32px;padding:0 12px;border-radius:3px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;color:var(--text-header);font-size:13px;border:none;position:relative}
.header-btn:hover{background:rgba(255,255,255,.35)}
.header-profile{display:flex;align-items:center;gap:8px;padding:0 8px;cursor:pointer;height:32px;border-radius:3px;color:var(--text-header)}
.header-profile:hover{background:rgba(255,255,255,.15)}
.header-profile .avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#5E98BA,#3d7a9c);display:flex;align-items:center;justify-content:center;font-weight:bold;color:#fff;font-size:12px}
.theme-dropdown,.data-dropdown{position:absolute;top:calc(100% + 6px);right:0;background:var(--bg-popup);border-radius:6px;box-shadow:0 8px 24px var(--shadow);min-width:200px;padding:6px;z-index:200;display:none}
.theme-dropdown.visible,.data-dropdown.visible{display:block}
.data-dropdown-header{padding:6px 12px;font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:600}
.theme-dropdown-item,.data-dropdown-item{padding:8px 12px;color:var(--text-primary);cursor:pointer;border-radius:4px;display:flex;align-items:center;gap:8px;font-size:13px}
.theme-dropdown-item:hover,.data-dropdown-item:hover{background:var(--bg-hover)}
.theme-dropdown-item.active{background:var(--accent);color:#fff}
.data-dropdown-divider{height:1px;background:var(--border-light);margin:4px 0}
.theme-swatch{width:14px;height:14px;border-radius:50%;flex-shrink:0}
.content-section{display:none}.content-section.active{display:block}
.dash-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px;margin-top:15px}
.dash-card{background:var(--bg-popup);border-radius:8px;padding:20px;color:var(--text-primary);box-shadow:0 2px 8px var(--shadow);transition:transform .15s}
.dash-card:hover{transform:translateY(-2px)}
.dash-card h3{margin:0 0 12px;font-size:14px;display:flex;align-items:center;gap:8px;color:var(--text-muted)}
.dash-card h3 .icon{font-size:18px}
.dash-stat{font-size:28px;font-weight:700;color:var(--text-primary);margin:4px 0}
.dash-stat-label{font-size:12px;color:var(--text-muted)}
.dash-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--border-light);font-size:13px}
.dash-row:last-child{border-bottom:none}
.dash-row .label{color:var(--text-muted)}
.dash-row .value{font-weight:600}
.dash-welcome{color:#fff;margin-bottom:20px}
.dash-welcome h1{margin:0 0 6px;font-size:24px;display:flex;align-items:center;gap:10px}
.dash-welcome p{margin:0;opacity:.8;font-size:14px}
.boards-list-container{margin-bottom:30px}
.boards-list-container>h1{color:#fff;font-size:16px;margin:0 0 16px;display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.1)}
.boards-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.board{position:relative;height:110px;background:var(--board-bg);padding:14px;color:#fff;border-radius:6px;text-decoration:none;transition:background .15s,transform .1s;box-shadow:0 2px 4px var(--shadow);cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.board:hover{background:var(--board-hover);transform:translateY(-2px)}
.board:hover .board-star{opacity:1}
.board-title{font-weight:600;font-size:14px;word-break:break-word}
.board-meta{display:flex;gap:8px;font-size:11px;opacity:.85;align-items:center;flex-wrap:wrap}
.board-category-badge{background:rgba(255,255,255,.2);padding:2px 8px;border-radius:10px;font-size:10px}
.board-add{background:rgba(255,255,255,.15);border:2px dashed rgba(255,255,255,.3);justify-content:center;align-items:center;text-align:center;gap:8px;font-size:13px}
.board-add:hover{background:rgba(255,255,255,.25)}
.board-star{position:absolute;top:8px;right:8px;opacity:0;cursor:pointer;transition:opacity .15s;padding:3px;border-radius:50%}
.board-star:hover{background:rgba(255,255,255,.15)}
.board-star.starred{color:gold;opacity:1}
.search-results-info{color:rgba(255,255,255,.8);font-size:13px;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.search-results-info button{background:rgba(255,255,255,.2);color:#fff;border:none;padding:3px 8px;border-radius:3px;cursor:pointer;font-size:11px}
.board-ribbon{display:flex;align-items:center;gap:12px;margin:-20px -25px 20px;padding:12px 20px;background:rgba(0,0,0,.15);color:#fff;flex-wrap:wrap}
.board-ribbon h1{margin:0;font-size:18px;font-weight:600}
.ribbon-item{display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border-radius:4px;cursor:pointer;font-size:13px}
.ribbon-item:hover{background:rgba(255,255,255,.15)}
.board-star-ribbon{opacity:.85}.board-star-ribbon.starred{color:gold;opacity:1}
#board_content{display:flex;gap:12px;align-items:flex-start;padding:10px 0;overflow-x:auto;padding-bottom:30px;min-height:calc(100vh - 250px)}
.list{background:var(--bg-list);width:272px;min-width:272px;max-height:75vh;border-radius:6px;flex-shrink:0;display:flex;flex-direction:column}
.list-head{padding:10px 12px;font-weight:600;font-size:14px;display:flex;justify-content:space-between;align-items:center;color:var(--text-primary)}
.list-head .icon-menu-btn{opacity:.5;cursor:pointer;padding:4px;border-radius:3px}
.list-head .icon-menu-btn:hover{opacity:1;background:rgba(0,0,0,.08)}
.list-body{flex:1;overflow-y:auto;padding:5px 0;min-height:30px}
.list-body.drag-over{background:rgba(0,121,191,.08)}
.card{margin:6px 8px;background:var(--bg-card);border-radius:4px;padding:8px 10px;cursor:pointer;box-shadow:0 1px 2px var(--shadow);position:relative}
.card:hover{filter:brightness(.97)}.card:hover .card-edit-btn{opacity:1}
.card.dragging-card{opacity:.5;transform:rotate(3deg)}
.card-edit-btn{position:absolute;top:4px;right:4px;width:22px;height:22px;background:var(--border-light);border-radius:3px;display:flex;align-items:center;justify-content:center;opacity:0;color:var(--text-muted)}
.card-title{font-size:13px;color:var(--text-card);word-wrap:break-word;padding-right:18px}
.card-badges{display:flex;gap:8px;margin-top:5px;font-size:11px;color:var(--text-muted)}
.card-badges span{display:inline-flex;align-items:center;gap:2px}
.card-subcards{margin-top:6px;padding-left:12px;border-left:2px solid var(--border-color)}
.card-subcards .subcard-item{margin:3px 0;padding:4px 8px;font-size:12px;background:var(--bg-hover);border-radius:3px;color:var(--text-primary)}
.card-meta{font-size:10px;color:var(--text-muted);margin-top:4px}
.card-cover-img{margin:-8px -10px 6px;border-radius:4px 4px 0 0;overflow:hidden;max-height:80px}
.card-cover-img img{width:100%;height:80px;object-fit:cover;display:block}
.add-list-btn{background:rgba(255,255,255,.2);width:272px;min-width:272px;padding:12px 15px;color:#fff;border-radius:6px;cursor:pointer;font-size:13px;flex-shrink:0;display:flex;align-items:center;gap:8px}
.add-list-btn:hover{background:rgba(255,255,255,.3)}
.add-card-btn{padding:8px 12px;color:var(--text-muted);cursor:pointer;font-size:13px;border-radius:4px;margin:4px 8px 8px}
.add-card-btn:hover{background:rgba(0,0,0,.05);color:var(--text-primary)}
.inline-form{background:var(--bg-list);padding:8px;border-radius:6px;width:272px;min-width:272px;flex-shrink:0}
.inline-form input[type="text"]{width:100%;padding:8px 10px;border:1px solid var(--border-color);border-radius:4px;margin-bottom:6px;background:var(--bg-input);color:var(--text-primary)}
.inline-form-actions{display:flex;align-items:center;gap:8px}
.view-toggle{display:flex;gap:4px}
.view-toggle button{padding:5px 12px;border-radius:4px;cursor:pointer;font-size:12px;border:1px solid var(--border-color);background:var(--bg-popup);color:var(--text-primary);font-weight:500}
.view-toggle button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.grid-card{position:relative;min-height:120px;background:var(--board-bg);padding:14px;color:#fff;border-radius:6px;transition:background .15s,transform .1s;box-shadow:0 2px 4px var(--shadow);cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.grid-card:hover{background:var(--board-hover);transform:translateY(-2px)}
.grid-card-title{font-weight:600;font-size:14px;word-break:break-word;margin-bottom:4px}
.grid-card-desc{font-size:11px;opacity:.8;margin-bottom:6px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.grid-card-meta{display:flex;gap:8px;font-size:10px;opacity:.75;flex-wrap:wrap}
.grid-card-actions{position:absolute;top:8px;right:8px;display:flex;gap:4px;opacity:0;transition:opacity .15s}
.grid-card:hover .grid-card-actions{opacity:1}
.grid-card-actions button{background:rgba(255,255,255,.2);border:none;color:#fff;padding:3px 6px;border-radius:3px;cursor:pointer;font-size:11px}
.grid-card-actions button:hover{background:rgba(255,255,255,.4)}
.cal-container{background:var(--bg-popup);border-radius:8px;padding:20px;min-height:calc(100vh - 160px);color:var(--text-primary)}
.cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px;flex-wrap:wrap;gap:10px}
.cal-header h2{margin:0;font-size:20px;font-weight:600}
.cal-nav{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.cal-nav button{background:var(--bg-hover);border:1px solid var(--border-color);border-radius:4px;padding:6px 12px;cursor:pointer;font-size:13px;color:var(--text-primary)}
.cal-nav button:hover{background:var(--border-light)}
.cal-view-toggle{display:flex;gap:4px}
.cal-view-toggle button{padding:5px 14px;border-radius:4px;cursor:pointer;font-size:12px;border:1px solid var(--border-color);background:var(--bg-popup);font-weight:500;color:var(--text-primary)}
.cal-view-toggle button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.cal-body{display:flex;gap:20px;margin-top:15px}
.cal-sidebar{width:260px;flex-shrink:0;overflow-y:auto;max-height:calc(100vh - 260px);border-right:1px solid var(--border-light);padding-right:15px}
.cal-sidebar h3{font-size:13px;color:var(--text-muted);margin:0 0 12px;font-weight:600;text-transform:uppercase}
.cal-event-item{padding:10px 12px;background:var(--bg-hover);border-radius:6px;margin-bottom:8px;border-left:3px solid var(--accent);font-size:12px;cursor:pointer}
.cal-event-item:hover{filter:brightness(.95)}
.cal-event-item .ev-title{font-weight:600;color:var(--text-primary);font-size:13px}
.cal-event-item .ev-date{color:var(--text-muted);font-size:11px;margin-top:3px}
.cal-event-item .ev-owner{color:var(--text-muted);font-size:10px;margin-top:2px}
.cal-grid{flex:1;min-width:0}
.cal-grid-year{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.cal-mini-month{border:1px solid var(--border-light);border-radius:8px;padding:10px;cursor:pointer;transition:all .15s}
.cal-mini-month:hover{background:var(--bg-hover);border-color:var(--accent)}
.cal-mini-month h4{margin:0 0 8px;font-size:13px;text-align:center;color:var(--accent);font-weight:600}
.cal-mini-grid{display:grid;grid-template-columns:repeat(7,1fr);font-size:10px;text-align:center;gap:1px}
.cal-mini-grid .mday{padding:3px 1px;border-radius:3px;color:var(--text-primary)}
.cal-mini-grid .mday.mtoday{background:var(--accent);color:#fff;font-weight:bold}
.cal-mini-grid .mday.mhas-event{background:var(--bg-hover);color:var(--accent);font-weight:600}
.cal-month-grid{display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--border-light);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px var(--shadow)}
.cal-day-header{background:var(--bg-hover);padding:10px 8px;text-align:center;font-size:12px;font-weight:600;color:var(--text-muted);border-bottom:1px solid var(--border-light)}
.cal-day{min-height:90px;padding:6px 8px;border:1px solid var(--border-light);cursor:pointer;transition:background .15s}
.cal-day:hover{background:var(--bg-hover)}
.cal-day .day-num{font-size:13px;font-weight:600;color:var(--text-primary);width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:50%}
.cal-day.today .day-num{background:var(--accent);color:#fff}
.cal-day.other-month{opacity:.4}
.crud-container{background:var(--bg-popup);border-radius:8px;padding:20px;color:var(--text-primary)}
.crud-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;flex-wrap:wrap;gap:8px}
.crud-header h2{margin:0;font-size:18px}
.crud-table{width:100%;border-collapse:collapse;font-size:13px}
.crud-table th{text-align:left;padding:10px;background:var(--bg-hover);border-bottom:2px solid var(--border-light);font-weight:600;color:var(--text-muted)}
.crud-table td{padding:10px;border-bottom:1px solid var(--border-light)}
.crud-table tr:hover{background:var(--bg-hover)}
.crud-actions{display:flex;gap:5px}
.crud-actions button{padding:4px 8px;border-radius:3px;cursor:pointer;font-size:11px;border:1px solid var(--border-color);background:var(--bg-popup);color:var(--text-primary)}
.crud-actions button:hover{background:var(--bg-hover)}
.crud-actions button.del{color:var(--btn-danger);border-color:var(--btn-danger)}
.pomodoro-container{background:var(--bg-popup);border-radius:8px;padding:30px;max-width:600px;margin:0 auto;color:var(--text-primary)}
.pomo-header{text-align:center;margin-bottom:20px}
.pomo-status{font-size:16px;font-weight:600;margin-bottom:4px}
.pomo-substatus{font-size:12px;color:var(--text-muted)}
.pomodoro-timer{font-size:64px;font-weight:200;text-align:center;margin:15px 0;font-variant-numeric:tabular-nums}
.pomodoro-controls{display:flex;gap:10px;justify-content:center;margin:20px 0}
.pomo-progress{display:flex;gap:4px;justify-content:center;margin:10px 0}
.pomo-dot{width:10px;height:10px;border-radius:50%;background:var(--border-color)}
.pomo-dot.done{background:var(--btn-green)}
.pomo-dot.current{background:var(--accent)}
.pomo-task-select{margin:15px 0;padding:15px;background:var(--bg-hover);border-radius:6px}
.pomo-task-select label{font-size:12px;font-weight:600;color:var(--text-muted);display:block;margin-bottom:4px}
.pomo-task-select select{width:100%;padding:8px;border:1px solid var(--border-color);border-radius:4px;background:var(--bg-input);color:var(--text-primary)}
.pomo-settings{margin-top:20px;padding-top:15px;border-top:1px solid var(--border-light);display:grid;grid-template-columns:1fr 1fr;gap:10px}
.pomo-settings label{font-size:12px;color:var(--text-muted);display:block;margin-bottom:3px}
.pomo-settings input{padding:6px 10px;border:1px solid var(--border-color);border-radius:4px;width:100%;background:var(--bg-input);color:var(--text-primary)}
.pomo-log{margin-top:20px;padding-top:15px;border-top:1px solid var(--border-light)}
.pomo-log h4{margin:0 0 8px;font-size:13px;color:var(--text-muted)}
.pomo-log-item{font-size:11px;color:var(--text-muted);padding:4px 0;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.settings-container{background:var(--bg-popup);border-radius:8px;padding:20px;max-width:600px;color:var(--text-primary)}
.settings-group{margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border-light)}
.settings-group h3{margin:0 0 10px;font-size:15px}
.settings-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0}
.settings-row label{font-size:13px}
.theme-options{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.theme-btn{padding:8px 14px;border-radius:6px;cursor:pointer;border:2px solid var(--border-color);font-size:12px;font-weight:500;background:var(--bg-popup);color:var(--text-primary);transition:all .15s;display:inline-flex;align-items:center;gap:6px}
.theme-btn:hover{border-color:var(--accent)}
.theme-btn.active{border-color:var(--accent);background:var(--accent);color:#fff}
#overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:var(--overlay-bg);z-index:-5;opacity:0;transition:opacity .2s;overflow-y:auto;display:flex;align-items:flex-start;justify-content:center;padding:40px 20px}
#overlay.visible{z-index:100;opacity:1}
.popup{background:var(--bg-popup);border-radius:8px;box-shadow:0 12px 40px var(--shadow);width:100%;max-width:420px;position:relative;display:none;color:var(--text-primary)}
.popup.visible{display:block}
.popup-header{padding:15px 20px;border-bottom:1px solid var(--border-light);display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:15px}
.popup-header .icon-cancel{cursor:pointer;color:var(--text-muted);padding:4px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%}
.popup-header .icon-cancel:hover{background:var(--bg-hover);color:var(--text-primary)}
.popup-body{padding:20px}
.popup-large{max-width:730px}
.popup-large .popup-body{display:flex;flex-wrap:wrap;padding:0}
.card-info-section{flex:1;min-width:280px;padding:20px}
.card-actions-section{width:200px;padding:20px;background:var(--bg-hover);border-radius:0 0 8px 0}
.card-actions-section h3{font-size:11px;color:var(--text-muted);text-transform:uppercase;margin:0 0 8px;font-weight:600}
.card-action-btn{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg-popup);border:1px solid var(--border-color);border-radius:4px;cursor:pointer;font-size:13px;color:var(--text-primary);width:100%;margin-bottom:6px;text-align:left}
.card-action-btn:hover{background:var(--bg-hover)}
.card-action-btn.danger{color:var(--btn-danger);border-color:var(--btn-danger)}
.attachment-item{display:flex;gap:10px;padding:8px;background:var(--bg-hover);border-radius:4px;margin-bottom:6px;align-items:center}
.attachment-thumb{width:60px;height:45px;border-radius:3px;overflow:hidden;flex-shrink:0}
.attachment-thumb img{width:100%;height:100%;object-fit:cover}
.attachment-info{flex:1;font-size:12px}
.attachment-info .att-name{font-weight:500;color:var(--text-primary)}
.attachment-actions{display:flex;gap:6px;font-size:11px}
.attachment-actions a{color:var(--accent);cursor:pointer}
.attachment-actions a:hover{text-decoration:underline}
.attachment-actions a.del{color:var(--btn-danger)}
.form-group{margin-bottom:12px}
.form-group label{display:block;font-size:12px;font-weight:600;color:var(--text-muted);margin-bottom:4px}
.form-control{width:100%;padding:8px 12px;border:1px solid var(--border-color);border-radius:4px;font-size:13px;background:var(--bg-input);color:var(--text-primary)}
.form-control:focus{border-color:var(--accent)}
textarea.form-control{resize:vertical;min-height:60px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 16px;border-radius:4px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:background .15s}
.btn-green{background:var(--btn-green);color:#fff}.btn-green:hover{background:var(--btn-green-hover)}
.btn-gray{background:var(--bg-hover);color:var(--text-primary);border:1px solid var(--border-color)}.btn-gray:hover{filter:brightness(.95)}
.btn-danger{background:var(--btn-danger);color:#fff}
.btn-sm{padding:5px 10px;font-size:12px}
.no-display{display:none!important}
.pointer{cursor:pointer}
.flex-gap{display:flex;gap:8px;align-items:center}
.section-label{font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin:12px 0 6px;display:flex;align-items:center;gap:6px}
body.drello-auth-locked .HolyGrail,
body.drello-auth-locked .HolyGrail-footer,
body.drello-auth-locked #overlay { display:none !important; }
.auth-overlay{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-start;justify-content:center;overflow:auto;background:var(--bg-primary);padding:40px 20px}
.auth-card{width:100%;max-width:420px;background:var(--bg-popup);border-radius:8px;box-shadow:0 12px 40px var(--shadow);color:var(--text-primary)}
.auth-body{padding:20px}
.auth-error{color:var(--btn-danger);min-height:18px;font-size:12px;margin-top:6px}
.auth-hidden{display:none!important}
.auth-admin-only{display:none!important}
body.drello-user-admin .auth-admin-only{display:flex!important}
.module-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;flex-wrap:wrap;gap:8px}
.module-header h2{margin:0;font-size:18px;display:flex;align-items:center;gap:8px}
.table-wrap{overflow:auto}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.form-grid .form-group{margin-bottom:0}
.task-type-tabs,.finance-tabs{display:flex;gap:4px;flex-wrap:wrap}
.task-type-tabs button,.finance-tabs button{padding:5px 12px;border-radius:4px;cursor:pointer;font-size:12px;border:1px solid var(--border-color);background:var(--bg-popup);color:var(--text-primary);font-weight:500}
.task-type-tabs button.active,.finance-tabs button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:16px}
.stat-box{background:var(--bg-popup);border-radius:8px;padding:14px;box-shadow:0 2px 8px var(--shadow)}
.stat-value{font-size:22px;font-weight:700}
.stat-label{font-size:12px;color:var(--text-muted)}
.pomo-log-dot{display:inline-block;width:8px;height:8px;border-radius:50%;flex-shrink:0}
.pomo-log-dot.work{background:var(--btn-danger)}
.pomo-log-dot.aux,.pomo-log-dot.break{background:var(--btn-green)}
</style>
</head>
<body data-theme="light" class="drello-auth-locked">
<div id="authOverlay" class="auth-overlay">
<div class="auth-card">
<div class="popup-header" style="display:flex;justify-content:space-between;align-items:center">
<span id="authTitle">Sign in</span>
</div>
<div class="auth-body">
<form id="authForm">
<div class="form-group auth-hidden" id="authNameWrap">
<label>Full name</label>
<input class="form-control" id="authName" autocomplete="name">
</div>
<div class="form-group">
<label>Username or email</label>
<input class="form-control" id="authIdentifier" autocomplete="username" required>
</div>
<div class="form-group">
<label>Password</label>
<input class="form-control" type="password" id="authPassword" autocomplete="current-password" required>
</div>
<div class="form-group auth-hidden" id="authConfirmWrap">
<label>Confirm password</label>
<input class="form-control" type="password" id="authConfirm" autocomplete="new-password">
</div>
<div id="authError" class="auth-error"></div>
<div class="flex-gap" style="justify-content:flex-end">
<button type="submit" class="btn btn-green" id="authSubmit">Sign in</button>
</div>
</form>
</div>
</div>
</div>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
<symbol id="icon-boards" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></symbol>

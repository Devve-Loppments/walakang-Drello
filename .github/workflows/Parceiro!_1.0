window.saveHealthForm=function(e){
e.preventDefault();
const id=$('#health_id').value||uid();
const rec={id:id,date:$('#health_date').value||todayISO(),owner:$('#health_owner').value||currentUserData?.name||'',ownerId:appUsers.find(u=>u.name===$('#health_owner').value)?.id||null,weightKg:numOrNull($('#health_weightKg').value),heightCm:numOrNull($('#health_heightCm').value),bodyFatPct:numOrNull($('#health_bodyFatPct').value),waistCm:numOrNull($('#health_waistCm').value),hipCm:numOrNull($('#health_hipCm').value),bpSys:numOrNull($('#health_bpSys').value),bpDia:numOrNull($('#health_bpDia').value),restingHr:numOrNull($('#health_restingHr').value),sleepHours:numOrNull($('#health_sleepHours').value),sleepQuality:$('#health_sleepQuality').value||null,stress:$('#health_stress').value||null,mood:$('#health_mood').value||null,waterMl:numOrNull($('#health_waterMl').value),caloriesKcal:numOrNull($('#health_caloriesKcal').value),proteinG:numOrNull($('#health_proteinG').value),carbsG:numOrNull($('#health_carbsG').value),fatG:numOrNull($('#health_fatG').value),steps:numOrNull($('#health_steps').value),exerciseMinutes:numOrNull($('#health_exerciseMinutes').value),medications:$('#health_medications').value.trim(),notes:$('#health_notes').value.trim(),updatedAt:Date.now()};
const idx=AppData.healthRecords.findIndex(x=>x.id===id);
if(idx>=0)AppData.healthRecords[idx]={...AppData.healthRecords[idx],...rec};
else{rec.createdAt=Date.now();AppData.healthRecords.push(rec)}
saveApp();renderHealth();closePopups();
};
window.deleteHealthRecord=function(id){if(!confirm('Delete this health record?'))return;AppData.healthRecords=AppData.healthRecords.filter(x=>x.id!==id);saveApp();renderHealth();};
function accountById(id){return AppData.finance.accounts.find(a=>a.id===id)}
function categoryById(id){return AppData.finance.categories.find(c=>c.id===id)}
function accountName(id){return accountById(id)?.name||'--'}
function categoryName(id){return categoryById(id)?.name||'--'}
function accountBalance(accountId){
const account=accountById(accountId);if(!account)return 0;
let balance=Number(account.openingBalance||0);
const sorted=[...AppData.finance.transactions].sort((a,b)=>String(a.date).localeCompare(String(b.date)));
for(const tx of sorted){
const amount=Number(tx.amount||0);
if(tx.type==='income'&&tx.accountId===accountId)balance+=amount;
if(tx.type==='expense'&&tx.accountId===accountId)balance-=amount;
if(tx.type==='transfer'){if(tx.accountId===accountId)balance-=amount;if(tx.toAccountId===accountId)balance+=amount}
}
return balance;
}
function financeMonthTotals(month){
const txs=AppData.finance.transactions.filter(tx=>String(tx.date).startsWith(month));
const income=txs.filter(tx=>tx.type==='income').reduce((s,tx)=>s+Number(tx.amount||0),0);
const expense=txs.filter(tx=>tx.type==='expense').reduce((s,tx)=>s+Number(tx.amount||0),0);
return {income,expense,net:income-expense};
}
function budgetSpent(budget){
return AppData.finance.transactions.filter(tx=>tx.type==='expense'&&tx.categoryId===budget.categoryId&&String(tx.date).startsWith(budget.month)).reduce((s,tx)=>s+Number(tx.amount||0),0);
}
function fillAccountSelect(select,selected){if(!select)return;select.innerHTML='<option value="">-- Account --</option>'+AppData.finance.accounts.map(a=>'<option value="'+esc(a.id)+'">'+esc(a.name)+'</option>').join('');if(selected)select.value=selected;}
function fillCategorySelect(select,type,selected){if(!select)return;const cats=AppData.finance.categories.filter(c=>c.type===type);select.innerHTML='<option value="">-- Category --</option>'+cats.map(c=>'<option value="'+esc(c.id)+'">'+esc(c.name)+'</option>').join('');if(selected)select.value=selected;}
window.updateTransactionFormVisibility=function(){const type=$('#tx_type')?.value;const toWrap=$('#tx_toAccountWrap'),catWrap=$('#tx_categoryWrap');if(toWrap)toWrap.style.display=type==='transfer'?'':'none';if(catWrap)catWrap.style.display=type==='transfer'?'none':'';};
window.setFinanceTab=function(tab,btn){$$('.finance-tabs button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');['dashboard','accounts','transactions','budgets'].forEach(p=>{const el=$('#finance_panel_'+p);if(el)el.classList.toggle('auth-hidden',p!==tab)});};
window.editFinanceAccountById=function(id){showFinanceAccountForm(accountById(id))};
window.editFinanceTransactionById=function(id){showFinanceTransactionForm(AppData.finance.transactions.find(x=>x.id===id))};
window.editFinanceBudgetById=function(id){showFinanceBudgetForm(AppData.finance.budgets.find(x=>x.id===id))};
window.renderFinance=function(){
const cur=AppData.finance.baseCurrency||'USD';const m=monthISO();const totals=financeMonthTotals(m);
const accountsTotal=AppData.finance.accounts.filter(a=>a.active!==false).reduce((s,a)=>s+accountBalance(a.id),0);
$('#finance_summary').innerHTML=statBox('Month income',fmtMoney(totals.income,cur))+statBox('Month expense',fmtMoney(totals.expense,cur))+statBox('Month net',fmtMoney(totals.net,cur))+statBox('Active accounts balance',fmtMoney(accountsTotal,cur));
const recent=[...AppData.finance.transactions].sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,10);
$('#finance_recent_body').innerHTML=recent.map(tx=>'<tr><td>'+esc(tx.date)+'</td><td>'+esc(tx.type)+'</td><td>'+esc(accountName(tx.accountId))+'</td><td>'+esc(tx.type==='transfer'?'--':categoryName(tx.categoryId))+'</td><td>'+esc(tx.payee||'')+'</td><td>'+esc(fmtMoney(tx.amount,cur))+'</td></tr>').join('');
$('#finance_accounts_body').innerHTML=AppData.finance.accounts.map(a=>'<tr><td>'+esc(a.name)+'</td><td>'+esc(a.type)+'</td><td>'+esc(fmtMoney(a.openingBalance,a.currency||cur))+'</td><td>'+esc(fmtMoney(accountBalance(a.id),a.currency||cur))+'</td><td>'+esc(a.active===false?'No':'Yes')+'</td><td class="crud-actions"><button onclick="editFinanceAccountById(\''+a.id+'\')">Edit</button><button class="del" onclick="deleteFinanceAccount(\''+a.id+'\')">Del</button></td></tr>').join('');
$('#finance_transactions_body').innerHTML=[...AppData.finance.transactions].sort((a,b)=>String(b.date).localeCompare(String(a.date))).map(tx=>'<tr><td>'+esc(tx.date)+'</td><td>'+esc(tx.type)+'</td><td>'+esc(accountName(tx.accountId))+'</td><td>'+esc(tx.type==='transfer'?accountName(tx.toAccountId):'--')+'</td><td>'+esc(tx.type==='transfer'?'--':categoryName(tx.categoryId))+'</td><td>'+esc(tx.payee||'')+'</td><td>'+esc(tx.description||'')+'</td><td>'+esc(fmtMoney(tx.amount,cur))+'</td><td class="crud-actions"><button onclick="editFinanceTransactionById(\''+tx.id+'\')">Edit</button><button class="del" onclick="deleteFinanceTransaction(\''+tx.id+'\')">Del</button></td></tr>').join('');
$('#finance_budgets_body').innerHTML=[...AppData.finance.budgets].sort((a,b)=>String(b.month).localeCompare(String(a.month))).map(b=>{const spent=budgetSpent(b);const remaining=Number(b.limit||0)-spent;return '<tr><td>'+esc(b.month)+'</td><td>'+esc(categoryName(b.categoryId))+'</td><td>'+esc(fmtMoney(b.limit,cur))+'</td><td>'+esc(fmtMoney(spent,cur))+'</td><td>'+esc(fmtMoney(remaining,cur))+'</td><td class="crud-actions"><button onclick="editFinanceBudgetById(\''+b.id+'\')">Edit</button><button class="del" onclick="deleteFinanceBudget(\''+b.id+'\')">Del</button></td></tr>';}).join('');
};
window.showFinanceAccountForm=function(account){
const f=document.querySelector('#popup_finance_account_form form');f.reset();
$('#account_id').value=account?.id||'';
$('#account_name').value=account?.name||'';
$('#account_type').value=account?.type||'bank';
$('#account_currency').value=account?.currency||AppData.finance.baseCurrency||'USD';
$('#account_openingBalance').value=account?.openingBalance??0;
$('#account_active').value=account?String(account.active!==false):'true';
$('#account_notes').value=account?.notes||'';
showPopup('popup_finance_account_form');
};
window.saveFinanceAccountForm=function(e){
e.preventDefault();
const id=$('#account_id').value||uid();
const account={id:id,name:$('#account_name').value.trim(),type:$('#account_type').value,currency:$('#account_currency').value.trim()||'USD',openingBalance:Number($('#account_openingBalance').value||0),active:$('#account_active').value==='true',notes:$('#account_notes').value.trim(),updatedAt:Date.now()};
if(!account.name){alert('Account name is required.');return}
const idx=AppData.finance.accounts.findIndex(a=>a.id===id);
if(idx>=0)AppData.finance.accounts[idx]={...AppData.finance.accounts[idx],...account};
else{account.createdAt=Date.now();AppData.finance.accounts.push(account)}
saveApp();renderFinance();closePopups();
};
window.deleteFinanceAccount=function(id){if(!confirm('Delete this account? Transactions will remain.'))return;AppData.finance.accounts=AppData.finance.accounts.filter(a=>a.id!==id);saveApp();renderFinance();};
window.showFinanceTransactionForm=function(tx){
const f=document.querySelector('#popup_finance_transaction_form form');f.reset();
$('#tx_id').value=tx?.id||'';
$('#tx_date').value=tx?.date||todayISO();
$('#tx_type').value=tx?.type||'expense';
fillAccountSelect($('#tx_account'),tx?.accountId);
fillAccountSelect($('#tx_toAccount'),tx?.toAccountId);
fillOwnerSelect($('#tx_owner'),tx?.owner||currentUserData?.name);
if(tx?.type&&tx.type!=='transfer')fillCategorySelect($('#tx_category'),tx.type,tx.categoryId);
else if(tx?.type!=='transfer')fillCategorySelect($('#tx_category'),'expense','');
else $('#tx_category').innerHTML='';
$('#tx_payee').value=tx?.payee||'';
$('#tx_amount').value=tx?.amount??'';
$('#tx_description').value=tx?.description||'';
updateTransactionFormVisibility();
showPopup('popup_finance_transaction_form');
};
window.saveFinanceTransactionForm=function(e){
e.preventDefault();
try{
const id=$('#tx_id').value||uid();const type=$('#tx_type').value;
const tx={id:id,date:$('#tx_date').value||todayISO(),type:type,accountId:$('#tx_account').value,toAccountId:type==='transfer'?$('#tx_toAccount').value:null,categoryId:type==='transfer'?null:$('#tx_category').value,payee:$('#tx_payee').value.trim(),description:$('#tx_description').value.trim(),amount:Number($('#tx_amount').value||0),owner:$('#tx_owner').value||currentUserData?.name||'',ownerId:appUsers.find(u=>u.name===$('#tx_owner').value)?.id||null,updatedAt:Date.now()};
if(!tx.accountId)throw new Error('Account is required.');
if(!(tx.amount>0))throw new Error('Amount must be greater than zero.');
if(type==='transfer'){if(!tx.toAccountId)throw new Error('Destination account is required for transfers.');if(tx.toAccountId===tx.accountId)throw new Error('Destination account must be different.')}
else{if(!tx.categoryId)throw new Error('Category is required.')}
const idx=AppData.finance.transactions.findIndex(x=>x.id===id);
if(idx>=0)AppData.finance.transactions[idx]={...AppData.finance.transactions[idx],...tx};
else{tx.createdAt=Date.now();AppData.finance.transactions.push(tx)}
saveApp();renderFinance();closePopups();
}catch(err){alert(err.message||'Could not save transaction.')}
};
window.deleteFinanceTransaction=function(id){if(!confirm('Delete this transaction?'))return;AppData.finance.transactions=AppData.finance.transactions.filter(x=>x.id!==id);saveApp();renderFinance();};
window.showFinanceBudgetForm=function(budget){
const f=document.querySelector('#popup_finance_budget_form form');f.reset();
$('#budget_id').value=budget?.id||'';
$('#budget_month').value=budget?.month||monthISO();
fillCategorySelect($('#budget_category'),'expense',budget?.categoryId);
$('#budget_limit').value=budget?.limit??'';
showPopup('popup_finance_budget_form');
};
window.saveFinanceBudgetForm=function(e){
e.preventDefault();
try{
const id=$('#budget_id').value||uid();
const budget={id:id,month:$('#budget_month').value,categoryId:$('#budget_category').value,limit:Number($('#budget_limit').value||0),updatedAt:Date.now()};
if(!budget.month)throw new Error('Month is required.');
if(!budget.categoryId)throw new Error('Category is required.');
if(!(budget.limit>0))throw new Error('Budget limit must be greater than zero.');
const idx=AppData.finance.budgets.findIndex(x=>x.id===id);
if(idx>=0)AppData.finance.budgets[idx]={...AppData.finance.budgets[idx],...budget};
else{budget.createdAt=Date.now();AppData.finance.budgets.push(budget)}
saveApp();renderFinance();closePopups();
}catch(err){alert(err.message||'Could not save budget.')}
};
window.deleteFinanceBudget=function(id){if(!confirm('Delete this budget?'))return;AppData.finance.budgets=AppData.finance.budgets.filter(x=>x.id!==id);saveApp();renderFinance();};
window.editUserById=function(id){showUserForm(getUserById(id))};
window.renderUsers=function(){
const body=$('#users_table_body');if(!body)return;
body.innerHTML=appUsers.map(u=>'<tr><td>'+esc(u.name)+'</td><td>'+esc(u.username)+'</td><td>'+esc(u.email||'')+'</td><td>'+esc(u.role)+'</td><td>'+esc(u.active?'Yes':'No')+'</td><td>'+esc(u.createdAt?new Date(u.createdAt).toLocaleDateString():'')+'</td><td class="crud-actions"><button onclick="editUserById(\''+u.id+'\')">Edit</button><button class="del" onclick="deleteUser(\''+u.id+'\')">Del</button></td></tr>').join('');
};
window.showUserForm=function(user){
$('#userDialogTitle').textContent=user?'Edit User':'New User';
$('#user_id').value=user?.id||'';
$('#user_name').value=user?.name||'';
$('#user_username').value=user?.username||'';
$('#user_email').value=user?.email||'';
$('#user_role').value=user?.role||'member';
$('#user_active').value=user?String(user.active!==false):'true';
$('#user_password').value='';
$('#user_password').placeholder=user?'Leave blank to keep current password':'Required';
showPopup('popup_user_form');
};
function replaceOwnerNames(oldName,newName){
if(!oldName||oldName===newName)return;
AppData.projects.forEach(p=>{if(p.owner===oldName)p.owner=newName});
AppData.tasks.forEach(t=>{if(t.owner===oldName)t.owner=newName});
AppData.events.forEach(ev=>{if(ev.owner===oldName)ev.owner=newName});
AppData.healthRecords.forEach(r=>{if(r.owner===oldName)r.owner=newName});
AppData.finance.transactions.forEach(tx=>{if(tx.owner===oldName)tx.owner=newName});
saveApp();
}
window.saveUserForm=async function(e){
e.preventDefault();
try{
const id=$('#user_id').value;
const name=$('#user_name').value.trim();
const username=$('#user_username').value.trim().toLowerCase();
const email=$('#user_email').value.trim();
const role=$('#user_role').value;
const active=$('#user_active').value==='true';
const password=$('#user_password').value;
if(!name||!username)throw new Error('Name and username are required.');
if(!/^[a-z0-9_.-]{3,32}$/.test(username))throw new Error('Username must be 3-32 characters and use letters, numbers, dot, dash or underscore.');
if(email&&!/^\S+@\S+\.\S+$/.test(email))throw new Error('Email is invalid.');
if(findDuplicateUser(username,email,id||null))throw new Error('Username or email already exists.');
if(id){
const user=getUserById(id);if(!user)throw new Error('User not found.');
const lastAdmin=(user.role==='admin'&&user.active&&appUsers.filter(u=>u.role==='admin'&&u.active&&u.id!==id).length===0);
if(lastAdmin&&(role!=='admin'||active===false))throw new Error('You cannot remove or deactivate the last active admin.');
if(password)user.auth=await makePasswordProof(password);
const oldName=user.name;
Object.assign(user,{name:name,username:username,email:email,role:role,active:active,updatedAt:Date.now()});
if(oldName!==name)replaceOwnerNames(oldName,name);
saveUsersStore();renderUsers();renderTasks();renderProjects();renderCalendar();renderHealth();renderFinance();applyCurrentUserUI();refreshOwnerSelects();closePopups();
}else{
if(!password)throw new Error('Password is required for new users.');
const auth=await makePasswordProof(password);
appUsers.push({id:uid(),name:name,username:username,email:email,role:role,active:active,createdAt:Date.now(),auth:auth});
saveUsersStore();renderUsers();refreshOwnerSelects();closePopups();
}
}catch(err){alert(err.message||'Could not save user.')}
};
window.deleteUser=function(id){
const user=getUserById(id);if(!user)return;
if(currentUserData&&currentUserData.id===id){alert('You cannot delete your own user from here.');return}
const lastAdmin=(user.role==='admin'&&user.active&&appUsers.filter(u=>u.role==='admin'&&u.active&&u.id!==id).length===0);
if(lastAdmin){alert('You cannot delete the last active admin.');return}
if(!confirm('Delete user '+user.name+'?'))return;
appUsers=appUsers.filter(u=>u.id!==id);saveUsersStore();renderUsers();refreshOwnerSelects();
};
const baseShowProjectForm=window.showProjectForm;
window.showProjectForm=function(p){baseShowProjectForm(p);fillOwnerSelect(document.querySelector('#popup_project_form select[name=powner]'),p?.owner||currentUserData?.name);};
const baseShowTaskForm=window.showTaskForm;
window.showTaskForm=function(t){baseShowTaskForm(t);fillOwnerSelect(document.querySelector('#popup_task_form select[name=towner]'),t?.owner||currentUserData?.name);};
const baseShowEventForm=window.showEventForm;
window.showEventForm=function(ds){baseShowEventForm(ds);fillOwnerSelect(document.querySelector('#popup_event_form select[name=eowner]'),currentUserData?.name);};
const baseEditEvent=window.editEvent;
window.editEvent=function(id){baseEditEvent(id);const ev=AppData.events.find(x=>x.id===id);fillOwnerSelect(document.querySelector('#popup_event_form select[name=eowner]'),ev?.owner);};
const baseShowView=window.showView;
window.showView=function(name){
if(name==='users'&&(!currentUserData||currentUserData.role!=='admin'))name='dashboard';
baseShowView(name);
if(name==='health')renderHealth();
if(name==='finance')renderFinance();
if(name==='users')renderUsers();
if(name==='tasks')renderTasks();
if(name==='pomodoro')pomoPopulateSelects();
};
window.handleLogout=function(){
const behavior=localStorage.getItem('drello_save_behavior')||'ask';
if(behavior==='ask'){if(confirm('Save data before logging out?'))exportDataSilent()}
else if(behavior==='auto')exportDataSilent();
saveApp();window.authLogout();
};
if(authForm)authForm.addEventListener('submit',handleAuthSubmit);
function init(){
if(!window.crypto?.subtle){authError.textContent='Web Crypto is unavailable. Serve this file over localhost or HTTPS.';authSubmit.disabled=true;return}
const session=getSession();
if(session){const u=getUserById(session.userId);if(u&&u.active){currentUserData=u;unlock();return}}
lock();
}
init();
})();
</script>
</body>
</html>
